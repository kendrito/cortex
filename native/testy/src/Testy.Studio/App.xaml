<Application x:Class="Testy.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Testy.Studio"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
  <!--
    Testy's design layer over the .NET 9 WPF Fluent theme.
    ThemeMode="System" merges PresentationFramework.Fluent (native control styles, light/dark, the Windows accent color and the Mica backdrop).
    Standard controls (Button, TextBox, ComboBox, CheckBox, ScrollViewer, ToolTip, menus, Expander, PasswordBox) use the Fluent styles unchanged.
    This file only adds what Fluent does not provide. Every color is a Fluent resource referenced with DynamicResource, so both themes and theme
    changes at runtime work. Pass/fail never uses the accent: it uses SystemFillColorSuccess/Critical/Caution plus an icon and a word.
    The resource keys and patterns are documented in docs\FRONTEND-HANDOFF.md ("Theme and shell").
  -->
  <Application.Resources>

    <!-- ═══════════════════════════ Type ═══════════════════════════ -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <!-- Values, selectors and IDs. Consolas is the working fallback when Cascadia Mono is not available. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:FriendlyTimeConverter x:Key="FriendlyTime"/>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Margin" Value="0,24,0,8"/>
    </Style>
    <Style x:Key="PaneTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HelpText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="16"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="EmptyTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <Style x:Key="EmptyLine" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MaxWidth" Value="340"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <!-- Keyboard key chip (Help flyout). -->
    <Style x:Key="KeyChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6,1"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Decorative icons: the glyph lives in a template, so screen readers don't announce private-use characters. Tag holds the glyph. -->
    <Style x:Key="Icon" TargetType="Control">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="EmptyIcon" TargetType="Control" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="32"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════ Surfaces ═══════════════════════════ -->
    <!-- The content layer beside the navigation pane (NavigationView content area over Mica). -->
    <Style x:Key="ContentLayer" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NavigationViewContentBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource NavigationViewContentGridBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,0,0"/><Setter Property="CornerRadius" Value="8,0,0,0"/>
    </Style>
    <!-- A card groups related content (8 px corners). -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- One setting per row, as in the Windows Settings app (4 px corners, 2 px apart). -->
    <Style x:Key="SettingCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="68"/><Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource HelpText}"><Setter Property="Margin" Value="0,2,16,0"/></Style>
    <Style x:Key="SettingIcon" TargetType="Control" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Margin" Value="4,0,20,0"/><Setter Property="Width" Value="20"/>
    </Style>
    <Style x:Key="VerticalDivider" TargetType="Rectangle">
      <Setter Property="Width" Value="1"/><Setter Property="Height" Value="24"/><Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HorizontalDivider" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/><Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/><Setter Property="Margin" Value="0,8"/>
    </Style>
    <!-- Flyout surface for the in-window Popups (Change app, Help). -->
    <Style x:Key="FlyoutSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource FlyoutBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource FlyoutBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="12,4,12,16"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#000000"/></Setter.Value></Setter>
    </Style>

    <!-- InfoBar (WinUI look). Informational by default; the severity styles change only the background and the icon. -->
    <Style x:Key="InfoBar" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="14,10,8,10"/><Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style x:Key="InfoBarSuccess" TargetType="Border" BasedOn="{StaticResource InfoBar}"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/></Style>
    <Style x:Key="InfoBarWarning" TargetType="Border" BasedOn="{StaticResource InfoBar}"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/></Style>
    <Style x:Key="InfoBarError" TargetType="Border" BasedOn="{StaticResource InfoBar}"><Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/></Style>
    <!-- InfoBar severity icon: a filled circle with a glyph. Tag = Informational | Success | Warning | Error. -->
    <Style x:Key="InfoBarIcon" TargetType="Control">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,2,12,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Grid Width="16" Height="16">
          <Ellipse x:Name="Circle" Fill="Transparent"/>
          <TextBlock x:Name="Glyph" Text="&#xF167;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="Success"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/><Setter TargetName="Glyph" Property="FontSize" Value="10"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/></Trigger>
          <Trigger Property="Tag" Value="Warning"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/><Setter TargetName="Glyph" Property="Text" Value="&#xF13C;"/><Setter TargetName="Glyph" Property="FontSize" Value="14"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/></Trigger>
          <Trigger Property="Tag" Value="Error"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/><Setter TargetName="Glyph" Property="FontSize" Value="9"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ Buttons ═══════════════════════════ -->
    <!-- Content stays a plain string (the UI Automation name). Tag carries an optional Segoe Fluent Icons glyph. -->
    <ControlTemplate x:Key="ButtonChrome" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="Overlay" CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Glyph" Property="Margin" Value="0"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Accent buttons lighten or darken on hover the way WinUI's AccentFillColorSecondary does. -->
    <ControlTemplate x:Key="AccentButtonChrome" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="Overlay" CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Overlay" Property="Opacity" Value="0"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="IconOnlyChrome" TargetType="Button">
      <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate>

    <!-- Standard (Fluent "Button") with an optional icon. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource ButtonChrome}"/>
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="11,0"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}"/><Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}"/><Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Accent: at most one per view (Run, Connect, Save). -->
    <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Template" Value="{StaticResource AccentButtonChrome}"/>
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Subtle (transparent until hovered): toolbars, app bar, list actions. -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
        <Trigger Property="Selector.IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Record: a filled dot in the Fluent critical color before the label (not a ring or a radio-button glyph). -->
    <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Icon-only subtle button: Content is the accessible name and the tooltip. -->
    <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Template" Value="{StaticResource IconOnlyChrome}"/><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, TargetNullValue='', FallbackValue=''}"/>
    </Style>
    <!-- App bar command (subtle, 16 px icon). -->
    <Style x:Key="AppBarButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Hyperlink-style button with a trailing chevron ("Change app ▾"). -->
    <Style x:Key="DropDownLinkButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border CornerRadius="4" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="8,2,0,0"/>
          </StackPanel>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════ Navigation pane ═══════════════════════════ -->
    <!-- NavigationView item: a plain Button (Invoke pattern). The selection pill appears when the attached Selector.IsSelected is set
         (MainWindow sets it with a DataTrigger on the page's Visibility). Content is the label and the accessible name. -->
    <Style x:Key="NavItem" TargetType="Button">
      <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}"/><Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
          <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"/>
          <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource NavigationViewSelectionIndicatorForeground}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
            <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            <ContentPresenter x:Name="Label" Margin="14,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}"/><Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPressed}"/></Trigger>
          <Trigger Property="Selector.IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Selector.IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></MultiTrigger>
          <Trigger Property="Tag" Value="Compact"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ Toggle switch ═══════════════════════════ -->
    <!-- WinUI ToggleSwitch look on a CheckBox (Toggle pattern). Content (optional) is shown before the switch; On/Off after it. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter x:Name="Label" Margin="0,0,12,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
          </Grid>
          <TextBlock x:Name="State" Grid.Column="2" Text="Off" MinWidth="26" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/><Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/><Setter TargetName="Knob" Property="Margin" Value="3,0,0,0"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
            <Setter TargetName="State" Property="Text" Value="On"/>
          </Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></MultiTrigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/><Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
          </Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ Text inputs ═══════════════════════════ -->
    <!-- The Fluent TextBox style stretches its content, which WPF turns into justified text in wrapping boxes. Pin left alignment. -->
    <Style x:Key="TextBoxBase" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="TextAlignment" Value="Left"/></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}"/>
    <!-- Same 32 px height as text boxes and buttons (the stock Fluent padding makes ComboBoxes 36 px). -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="Padding" Value="11,5,0,6"/></Style>
    <!-- Fluent TextBox chrome with a placeholder (Tag) and a search glyph. The placeholder is never the Text value. -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="ContentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextControlPlaceholderForeground}" Margin="11,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
              <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextControlButtonForeground}" Margin="0,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <Border x:Name="AccentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/><Setter TargetName="AccentBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}"/><Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Multi-line Fluent box whose text starts at the top and scrolls (the stock Fluent template centers its content host). Tag (optional) is a placeholder, never the Text value. -->
    <Style x:Key="MultiLineBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
      <Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="10,6,10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="ContentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextControlPlaceholderForeground}" Margin="13,7,11,0" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
            </Grid>
          </Border>
          <Border x:Name="AccentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/><Setter TargetName="AccentBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}"/></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}"/><Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PromptBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MultiLineBox}"><Setter Property="Height" Value="104"/></Style>
    <!-- Test title and purpose read as a document: borderless until hovered or focused. -->
    <Style x:Key="InlineEdit" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6,2"/><Setter Property="MinHeight" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="ContentBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
          </Border>
          <Border x:Name="AccentBorder" CornerRadius="4" BorderThickness="0" BorderBrush="Transparent" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/><Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter TargetName="AccentBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
      <Setter Property="Width" Value="84"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="CodeEditor" TargetType="TextBox" BasedOn="{StaticResource MultiLineBox}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="AcceptsTab" Value="True"/><Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- DataGrid cell editors: no chrome, the cell draws the focus border. -->
    <Style x:Key="CellEditor" TargetType="TextBox">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CellEditorMono" TargetType="TextBox" BasedOn="{StaticResource CellEditor}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3,0,4"/></Style>

    <!-- ═══════════════════════════ Tabs (SelectorBar look) ═══════════════════════════ -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="{TemplateBinding BorderThickness}">
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="0"/>
          </Border>
          <Border Grid.Row="1" Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
          </Border>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Tag (optional) is a count shown after the header: "Steps (5)". -->
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,8,12,10"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
          <Border x:Name="Bg" CornerRadius="4" Margin="0,4,0,6" Background="Transparent"/>
          <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <TextBlock x:Name="Count" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, StringFormat=({0})}" Foreground="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border x:Name="Pill" Width="16" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Count" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="Tag"><Trigger.Value><sys:Int32>0</sys:Int32></Trigger.Value><Setter TargetName="Count" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ DataGrid (WinUI table look) ═══════════════════════════ -->
    <!-- Rows stay DataGridRow (UI Automation DataItem with SelectionItem). Selection is a subtle fill plus the accent pill. -->
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGrid">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <!-- A grid whose columns always fit (Steps) sets ScrollViewer.HorizontalScrollBarVisibility="Disabled", so wrapped cells get the viewport width. -->
          <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
            <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Margin="4,0,0,0" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
            </ControlTemplate></ScrollViewer.Template>
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderGripper" TargetType="Thumb">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
        <Grid Background="{TemplateBinding Background}">
          <Border Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <TextBlock x:Name="SortGlyph" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGripper}"/>
          <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
          <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortGlyph" Property="Text" Value="&#xE70E;"/><Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortGlyph" Property="Text" Value="&#xE70D;"/><Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderFirst" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="14,0,12,0"/></Style>
    <Style x:Key="HeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
        <Grid Margin="4,0,0,0">
          <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <SelectiveScrollingGrid>
              <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></SelectiveScrollingGrid.ColumnDefinitions>
              <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></SelectiveScrollingGrid.RowDefinitions>
              <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                        SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
              <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                 Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
            </SelectiveScrollingGrid>
          </Border>
          <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource ListViewItemPillFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
          <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CellFirst" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="14,0,12,0"/></Style>
    <Style x:Key="EditableCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsEditing" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EditableCellFirst" TargetType="DataGridCell" BasedOn="{StaticResource EditableCell}"><Setter Property="Padding" Value="14,0,12,0"/></Style>
    <!-- Step rows: a step sentence wraps to two 20 px lines, and the number and verb stay on its first line. One line gives the usual 42 px row. -->
    <Style x:Key="SentenceCell" TargetType="DataGridCell" BasedOn="{StaticResource EditableCell}"><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="12,10,12,9"/></Style>
    <Style x:Key="SentenceCellFirst" TargetType="DataGridCell" BasedOn="{StaticResource EditableCell}"><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="14,10,12,9"/></Style>
    <!-- Cell text styles (TargetType TextBlock). -->
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="CellSecondary" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="CellMonoSmall" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
    <!-- Friendly local time with the full date and time in the tooltip. -->
    <Style x:Key="CellTime" TargetType="TextBlock" BasedOn="{StaticResource CellSecondary}">
      <Setter Property="ToolTip" Value="{Binding StartedAt, Converter={StaticResource FriendlyTime}, ConverterParameter=full}"/>
    </Style>
    <!-- Step verbs render as quiet chips; checks (assertions) carry a check mark. Never the accent. -->
    <Style x:Key="VerbChip" TargetType="ComboBox" BasedOn="{StaticResource {x:Static DataGridComboBoxColumn.TextBlockComboBoxStyleKey}}">
      <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Border x:Name="Chip" Height="22" CornerRadius="4" Padding="7,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left" SnapsToDevicePixels="True">
          <DockPanel VerticalAlignment="Center" LastChildFill="True">
            <TextBlock x:Name="Mark" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="Verb" Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Action}" Value="AssertText"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Verb" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding Action}" Value="AssertExists"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Verb" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding Action}" Value="AssertNotExists"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Verb" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding Action}" Value="AssertEnabled"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Verb" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Read-only booleans inside grids: a check mark or a dash. -->
    <Style x:Key="GridBool" TargetType="CheckBox">
      <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <TextBlock x:Name="Mark" Text="–" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/><Setter TargetName="Mark" Property="FontFamily" Value="{StaticResource IconFont}"/><Setter TargetName="Mark" Property="FontSize" Value="12"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GridBoolWarn" TargetType="CheckBox" BasedOn="{StaticResource GridBool}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <TextBlock x:Name="Mark" Text="–" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Text" Value="&#xE7BA;"/><Setter TargetName="Mark" Property="FontFamily" Value="{StaticResource IconFont}"/><Setter TargetName="Mark" Property="FontSize" Value="12"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ Status: icon + word, never the accent ═══════════════════════════ -->
    <DataTemplate x:Key="StatusPill">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse x:Name="Dot" Width="14" Height="14" Fill="Transparent" Stroke="{DynamicResource SystemFillColorNeutralBrush}" StrokeThickness="1.2"/>
          <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource TextFillColorInverseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="Label" Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="Passed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Failed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/><Setter TargetName="Glyph" Property="FontSize" Value="8"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Cancelled"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSolidNeutralBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE73B;"/><Setter TargetName="Glyph" Property="FontSize" Value="6"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Skipped"><Setter TargetName="Glyph" Property="Text" Value="&#xE738;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorNeutralBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Running"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Dot" Property="StrokeThickness" Value="2"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Pending"><Setter TargetName="Dot" Property="StrokeDashArray" Value="2 2"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="StatusNode">
      <Grid Width="18" Height="18">
        <Ellipse x:Name="Circle" Fill="Transparent" Stroke="{DynamicResource SystemFillColorNeutralBrush}" StrokeThickness="1.5" StrokeDashArray="2 2"/>
        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource TextFillColorInverseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Ellipse x:Name="Core" Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="Passed"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/><Setter TargetName="Circle" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/><Setter TargetName="Glyph" Property="FontSize" Value="10"/><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Failed"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/><Setter TargetName="Circle" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/><Setter TargetName="Glyph" Property="FontSize" Value="9"/><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Cancelled"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorSolidNeutralBrush}"/><Setter TargetName="Circle" Property="Stroke" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE73B;"/><Setter TargetName="Glyph" Property="FontSize" Value="7"/><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Skipped"><Setter TargetName="Circle" Property="StrokeDashArray" Value="{x:Null}"/><Setter TargetName="Glyph" Property="Text" Value="&#xE738;"/><Setter TargetName="Glyph" Property="FontSize" Value="9"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorNeutralBrush}"/><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Running"><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Circle" Property="StrokeDashArray" Value="{x:Null}"/><Setter TargetName="Core" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════════════════════ Lists ═══════════════════════════ -->
    <!-- ListView-style item: subtle hover and selection, accent pill on the selected item. -->
    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="4,1"/><Setter Property="Padding" Value="12,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource ListViewItemForeground}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource ListViewItemPillFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></MultiTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Test library item: its UI Automation name is the test name (verifiers select tests by name). -->
    <Style x:Key="LibraryItem" TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    </Style>
    <!-- The Fluent ListBox template adds padding and a border; this one keeps panes edge to edge. -->
    <Style x:Key="FlatList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ═══════════════════════════ Tests page and Last run (Phase 2) ═══════════════════════════ -->
    <local:PluralConverter x:Key="Plural"/>
    <local:RunOutcomeConverter x:Key="RunOutcome"/>

    <!-- Editor view switcher (Steps, Last run, JSON): a TabControl that shows only its headers. The views are separate panels, so their
         content stays in the UI Automation tree once shown. TabItems keep the SelectionItem pattern. -->
    <Style x:Key="ViewSwitcher" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Split button: an accent main part and a chevron part that opens a menu (Run and its mode). Both are plain Buttons (Invoke). -->
    <ControlTemplate x:Key="AccentSplitMainChrome" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border CornerRadius="4,0,0,4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="Overlay" CornerRadius="4,0,0,4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Overlay" Property="Opacity" Value="0"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="AccentSplitDropChrome" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border CornerRadius="0,4,4,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="Overlay" CornerRadius="0,4,4,0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False"/>
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Overlay" Property="Opacity" Value="0"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="AccentSplitMain" TargetType="Button" BasedOn="{StaticResource AccentIconButton}"><Setter Property="Template" Value="{StaticResource AccentSplitMainChrome}"/></Style>
    <Style x:Key="AccentSplitDrop" TargetType="Button" BasedOn="{StaticResource AccentIconButton}">
      <Setter Property="Template" Value="{StaticResource AccentSplitDropChrome}"/><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, TargetNullValue='', FallbackValue=''}"/>
    </Style>

    <!-- Text link as a button (Invoke pattern), e.g. the next getting-started step. -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0,2"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- A button that reads as a list row (Activity under the run's steps). Set AutomationProperties.Name: its content is a panel. -->
    <Style x:Key="ListRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,0,12,0"/><Setter Property="MinHeight" Value="44"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Latest-run status in the test list: a success check, a critical cross, or a hollow circle when the test has not run. -->
    <DataTemplate x:Key="LibraryStatusGlyph">
      <Grid Width="16" Height="16">
        <Ellipse Width="12" Height="12" StrokeThickness="1.2">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="Passed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Failed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Cancelled"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Running"><Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <Control HorizontalAlignment="Center">
          <Control.Style>
            <Style TargetType="Control" BasedOn="{StaticResource Icon}">
              <Setter Property="Visibility" Value="Collapsed"/><Setter Property="FontSize" Value="14"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="Passed"><Setter Property="Visibility" Value="Visible"/><Setter Property="Tag" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Failed"><Setter Property="Visibility" Value="Visible"/><Setter Property="Tag" Value="&#xE711;"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Cancelled"><Setter Property="Visibility" Value="Visible"/><Setter Property="Tag" Value="&#xE71A;"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Control.Style>
        </Control>
      </Grid>
    </DataTemplate>
    <!-- Test list group header ("Customer Desk", "2 tests"). -->
    <DataTemplate x:Key="LibraryGroupHeader">
      <DockPanel Margin="12,14,12,4">
        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, Converter={StaticResource Plural}, ConverterParameter=test}" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>

    <!-- A step of the displayed run (Last run). Its UI Automation name is "Step 4, Click Add customer, passed, 0.4 s". -->
    <Style x:Key="RunStepItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,9,14,9"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource ListViewItemPillFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
          <Border x:Name="FocusFrame" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusFrame" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Activity entries: compact rows; the UI Automation name is the time and the message. -->
    <Style x:Key="ActivityItem" TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
      <Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
    </Style>
    <!-- Global search result: the UI Automation name is the test name. IsHighlighted marks the result Enter opens. -->
    <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource ListViewItemPillFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
          <DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- App-bar search box: the SearchBox look plus a Ctrl+K hint while it is empty and unfocused. -->
    <Style x:Key="GlobalSearchBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="ContentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextControlPlaceholderForeground}" Margin="11,0,0,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
              <Border x:Name="Hint" Grid.Column="1" Style="{StaticResource KeyChip}" Padding="5,0,5,1" Margin="6,0,8,0" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="Ctrl+K" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </Border>
              <TextBlock Grid.Column="2" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextControlButtonForeground}" Margin="0,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <Border x:Name="AccentBorder" CornerRadius="{TemplateBinding Border.CornerRadius}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocused" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></MultiTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/><Setter TargetName="AccentBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}"/><Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- In-window side pane (Activity): an opaque flyout surface docked to the right edge of the content layer. -->
    <Style x:Key="PaneSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource FlyoutBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="180" Opacity="0.24" Color="#000000"/></Setter.Value></Setter>
    </Style>
    <!-- Small bold word before a step sentence ("Click", "Type", "Check"). -->
    <Style x:Key="StepVerb" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Application.Resources>
</Application>
