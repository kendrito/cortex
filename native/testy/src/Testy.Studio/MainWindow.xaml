<Window x:Class="Testy.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Testy.Studio"
        Title="Testy" Icon="/Assets/Testy.ico" Width="1480" Height="920" MinWidth="1100" MinHeight="640" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" Deactivated="Window_Deactivated" LocationChanged="Window_LocationChanged"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource UIFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!--
    Shell: NavigationView-style pane (left) over the Mica backdrop, and a content layer with the app bar, the pages and a slim status line.
    Pages are declared here and toggled with Visibility (a page shown once stays in the UI Automation tree, offscreen, when hidden).
    Automate is the exception: AutomatePage is built fresh in AutomateHost when NavWorkflows is invoked and removed when you leave it.
    The Tests page has two columns (tests and the "New test from a description" composer; the editor). The editor switches between the
    Steps, Last run and JSON views; in Last run its header compacts to one row (title, views, Save, Run again) so the run trace, the step list
    and the screenshot get the height. The Activity pane overlays the right edge of the content layer while it is open.
  -->
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- ═══════════════ Navigation pane ═══════════════ -->
    <Grid x:Name="NavPane" Margin="4,6,4,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Button x:Name="LibraryNav" Content="Tests" Tag="&#xE9D5;" Click="LibraryNav_Click" ToolTip="Tests (Ctrl+1)" AutomationProperties.AutomationId="NavLibrary">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavItem}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=LibraryPage}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button x:Name="RunsNav" Content="Results" Tag="&#xE9D2;" Click="RunsNav_Click" ToolTip="Results (Ctrl+2)" AutomationProperties.AutomationId="NavRuns">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavItem}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=RunsPage}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button x:Name="WorkflowsNav" Content="Automate" Tag="&#xE823;" Click="Workflows_Click" ToolTip="Automate: background runs, schedules, test sets and virtual machines (Ctrl+3)" AutomationProperties.AutomationId="NavWorkflows">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavItem}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AutomateHost}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </StackPanel>
      <StackPanel Grid.Row="2">
        <Button x:Name="HelpNav" Style="{StaticResource NavItem}" Content="Help" Tag="&#xE897;" Click="Help_Click" ToolTip="Documentation, keyboard shortcuts and version (F1)" AutomationProperties.AutomationId="NavHelp"/>
        <Rectangle Height="1" Fill="{DynamicResource NavigationViewItemSeparatorForeground}" Margin="4,4"/>
        <Button x:Name="SettingsNav" Content="Settings" Tag="&#xE713;" Click="SettingsNav_Click" ToolTip="Settings: AI service and how tests run (Ctrl+,)" AutomationProperties.AutomationId="NavSettings">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavItem}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsPage}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ═══════════════ Content layer ═══════════════ -->
    <Border Grid.Column="1" Style="{StaticResource ContentLayer}">
      <Grid x:Name="ContentGrid">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- App bar: the connected app, the commands that act on it, search, activity and the technical-details switch. -->
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="16,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="AppCard" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="No app is connected. Use Change app or Sample app.">
              <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                <Grid>
                  <TextBlock x:Name="AppInitials" FontFamily="{StaticResource SmallFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorInverseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Control x:Name="AppGlyph" Style="{StaticResource Icon}" Tag="&#xE7F4;" FontSize="16" Foreground="{DynamicResource TextFillColorInverseBrush}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppName" Text="No app connected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,1,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                  <TextBlock x:Name="TargetStatus" Text="Not connected" Style="{StaticResource Caption}" AutomationProperties.AutomationId="TargetStatus"/>
                  <TextBlock x:Name="TargetPid" Style="{StaticResource Caption}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240"
                             Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <!-- The AI picks the app from the test; choosing one by hand is a technical-details override. -->
            <Button x:Name="ChangeAppButton" Grid.Column="1" Style="{StaticResource DropDownLinkButton}" Content="Change app" Click="ChangeApp_Click" Margin="8,0,0,0" ToolTip="Technical override: connect to another running app, or open one" AutomationProperties.AutomationId="ChangeApp"
                    Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
            <Rectangle Grid.Column="2" Style="{StaticResource VerticalDivider}" Margin="12,0,8,0"/>
            <Button x:Name="SampleAppButton" Grid.Column="3" Style="{StaticResource AppBarButton}" Content="Sample app" Tag="&#xE8A7;" Click="LaunchLab_Click" ToolTip="Technical override: open the included Customer Desk sample app and connect to it" AutomationProperties.AutomationId="LaunchLab"
                    Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
            <Button x:Name="InspectButton" Grid.Column="4" Content="Inspect controls" Tag="&#xE8E6;" Click="InspectorNav_Click" Margin="4,0,0,0" ToolTip="See the controls Testy can find in the connected app (Ctrl+I)" AutomationProperties.AutomationId="NavInspector">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AppBarButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=InspectorPage}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <TextBox x:Name="GlobalSearch" Grid.Column="6" Style="{StaticResource GlobalSearchBox}" Tag="Search tests and steps" Width="248" Margin="12,0,0,0"
                     TextChanged="GlobalSearch_TextChanged" PreviewKeyDown="GlobalSearch_PreviewKeyDown" ToolTip="Search test names, purposes and steps (Ctrl+K)"
                     AutomationProperties.Name="Search tests and steps" AutomationProperties.AutomationId="GlobalSearch"/>
            <Button x:Name="ActivityButton" Grid.Column="7" Content="Activity" Tag="&#xE81C;" Click="ActivityButton_Click" Margin="6,0,0,0" ToolTip="Activity: every message, save, run and error in this session" AutomationProperties.AutomationId="ActivityButton">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AppBarButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ActivityPanel}" Value="Visible"><Setter Property="Selector.IsSelected" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <CheckBox x:Name="TechToggle" Grid.Column="8" Style="{StaticResource ToggleSwitch}" Content="Show technical details" Margin="12,0,0,0"
                      ToolTip="Show selectors, IDs, process numbers, JSON and raw results" AutomationProperties.Name="Show technical details"
                      IsChecked="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Mode=TwoWay}" AutomationProperties.AutomationId="ShowTechnicalDetails"/>
          </Grid>
        </Border>
        <!-- Activity sweep: visible only while an operation can be stopped. -->
        <Rectangle Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource AccentFillColorDefaultBrush}">
          <Rectangle.OpacityMask>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
              <GradientStop Color="Transparent" Offset="0.35"/><GradientStop Color="Black" Offset="0.5"/><GradientStop Color="Transparent" Offset="0.65"/>
            </LinearGradientBrush>
          </Rectangle.OpacityMask>
          <Rectangle.Style>
            <Style TargetType="Rectangle">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                  <DataTrigger.EnterActions><BeginStoryboard x:Name="SweepSb"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)" From="-0.7" To="0.7" Duration="0:0:1.2" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                  <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SweepSb"/></DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Rectangle.Style>
        </Rectangle>

        <!-- ═══════════════ Tests page ═══════════════ -->
        <Grid Grid.Row="1" x:Name="LibraryPage">
          <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- Tests: new, filter, the grouped list (ListItem name = test name), and the composer at the bottom. -->
          <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="12,14,12,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="New test" Tag="&#xE710;" Click="NewTest_Click" ToolTip="New test (Ctrl+N)" AutomationProperties.AutomationId="NewTest"/>
                <TextBox x:Name="SearchTests" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Filter" Margin="8,0,0,0" TextChanged="SearchTests_Changed" ToolTip="Filter tests by name or group (Ctrl+F)" AutomationProperties.Name="Filter tests" AutomationProperties.AutomationId="SearchTests"/>
              </Grid>
              <ListBox x:Name="TestList" Grid.Row="1" Style="{StaticResource FlatList}" Padding="4,0,4,8" ItemContainerStyle="{StaticResource LibraryItem}" SelectionChanged="TestList_SelectionChanged" KeyDown="TestList_KeyDown" IsSynchronizedWithCurrentItem="False"
                       VirtualizingPanel.IsVirtualizingWhenGrouping="False" AutomationProperties.Name="Tests" AutomationProperties.AutomationId="TestLibrary">
                <ListBox.GroupStyle><GroupStyle HeaderTemplate="{StaticResource LibraryGroupHeader}"/></ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding ToolTipText}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <ContentPresenter Content="{Binding StatusKind}" ContentTemplate="{StaticResource LibraryStatusGlyph}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" Margin="10,2,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StepCount}" Style="{StaticResource Caption}" Margin="8,2,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=TestList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Control Tag="&#xE9D5;" Style="{StaticResource EmptyIcon}"/>
                <TextBlock x:Name="LibraryEmptyText" Text="No tests yet" Style="{StaticResource EmptyTitle}"/>
                <TextBlock Text="Create one with New test, or describe it below." Style="{StaticResource EmptyLine}" MaxWidth="220"/>
              </StackPanel>
              <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,14,16,16">
                <StackPanel>
                  <TextBlock Text="New test from a description" Style="{StaticResource PaneTitle}"/>
                  <TextBlock x:Name="ComposerHelp" Text="The assistant writes the steps. You review them before running." Style="{StaticResource HelpText}" Margin="0,2,0,10"/>
                  <TextBox x:Name="PromptBox" Style="{StaticResource PromptBoxStyle}" Height="92" Tag="Describe what a user does…" AutomationProperties.Name="Describe a test" AutomationProperties.AutomationId="AiPrompt"/>
                  <Button x:Name="GenerateButton" Style="{StaticResource IconButton}" Content="Create test" Tag="&#xE710;" Click="Generate_Click" HorizontalAlignment="Right" Margin="0,10,0,0" ToolTip="Write a new test from this description, using the connected app's real controls" AutomationProperties.AutomationId="GenerateTest"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Editor: header (getting started, messages, title, purpose, commands, views), then the Steps, Last run or JSON view. -->
          <Grid Grid.Column="1" x:Name="EditorColumn">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="EditorHeader" Margin="28,16,28,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Row 0: getting started (dismissible, remembered per user, hidden when all three are done). -->
              <Border x:Name="GettingStarted" Grid.ColumnSpan="4" Style="{StaticResource InfoBar}" Padding="14,10,6,10" Margin="0,0,0,14" Visibility="Collapsed"
                      AutomationProperties.Name="Getting started">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Control Style="{StaticResource InfoBarIcon}" Tag="Informational" Margin="0,2,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock><Run Text="Getting started" FontWeight="SemiBold"/><Run Text="   "/><Run x:Name="GettingStartedCount" Text="0 of 3 done" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                    <WrapPanel Margin="0,6,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                        <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Ellipse x:Name="StartAiRing" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"/>
                          <TextBlock x:Name="StartAiMark" Text="1" FontFamily="{StaticResource SmallFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Button x:Name="StartAiLink" Style="{StaticResource LinkButton}" Content="Choose an AI" Click="StartAi_Click" ToolTip="Choose the AI service in Settings, or Offline" AutomationProperties.AutomationId="GettingStartedAi"/>
                      </StackPanel>
                      <Control Style="{StaticResource Icon}" Tag="&#xE76C;" FontSize="10" Margin="0,0,10,2" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                        <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Ellipse x:Name="StartConnectRing" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"/>
                          <TextBlock x:Name="StartConnectMark" Text="2" FontFamily="{StaticResource SmallFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Button x:Name="StartConnectLink" Style="{StaticResource LinkButton}" Content="Describe a test" Click="StartConnect_Click" ToolTip="Describe what to test and name the app; the AI finds it and gets there" AutomationProperties.AutomationId="GettingStartedDescribe"/>
                      </StackPanel>
                      <Control Style="{StaticResource Icon}" Tag="&#xE76C;" FontSize="10" Margin="0,0,10,2" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                        <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Ellipse x:Name="StartRunRing" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"/>
                          <TextBlock x:Name="StartRunMark" Text="3" FontFamily="{StaticResource SmallFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Button x:Name="StartRunLink" Style="{StaticResource LinkButton}" Content="Run a test" Click="StartRun_Click" ToolTip="Run the selected test (F5)" AutomationProperties.AutomationId="GettingStartedRun"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource IconOnlyButton}" Content="Dismiss getting started" Tag="&#xE711;" FontSize="12" Click="DismissGettingStarted_Click" VerticalAlignment="Top" AutomationProperties.AutomationId="DismissGettingStarted"/>
                </Grid>
              </Border>

              <!-- Row 1: assistant replies and errors (an InfoBar, never a chat), and the bar for a selected test changed or deleted outside Studio. -->
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                <Border x:Name="EditorMessage" Style="{StaticResource InfoBar}" Padding="14,8,6,8" MinHeight="44" Margin="0,0,0,12" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control x:Name="EditorMessageIcon" Style="{StaticResource InfoBarIcon}" Tag="Informational" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="EditorMessageText" Grid.Column="1" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="EditorMessageText"/>
                    <Button Grid.Column="2" Style="{StaticResource IconOnlyButton}" Content="Close message" Tag="&#xE711;" FontSize="12" Click="DismissEditorMessage_Click" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.AutomationId="DismissEditorMessage"/>
                  </Grid>
                </Border>
                <!-- The selected test was changed outside Studio (an agent through MCP, another tool) while the editor has unsaved edits, or its file was
                     deleted. A UserControl so the bar itself is in the UI Automation tree; Reload / Keep my edits or Save a copy / Discard show per case. -->
                <UserControl x:Name="ExternalChangeBar" Visibility="Collapsed" Focusable="False" Margin="0,0,0,12" AutomationProperties.Name="Changed outside Studio" AutomationProperties.AutomationId="ExternalChangeBar">
                  <Border Style="{StaticResource InfoBarWarning}" Padding="14,8,8,8" MinHeight="44">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Control Style="{StaticResource InfoBarIcon}" Tag="Warning" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <TextBlock x:Name="ExternalChangeText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="ExternalChangeText" AutomationProperties.LiveSetting="Polite"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="ReloadExternalButton" Style="{StaticResource IconButton}" Content="Reload" Tag="&#xE72C;" Click="ReloadExternalChange_Click" ToolTip="Replace your unsaved edits with the version now on disk" AutomationProperties.AutomationId="ReloadExternalChange"/>
                        <Button x:Name="KeepEditsButton" Style="{StaticResource IconButton}" Content="Keep my edits" Click="KeepMyEdits_Click" Margin="8,0,0,0" ToolTip="Keep editing; saving replaces the version on disk" AutomationProperties.AutomationId="KeepMyEdits"/>
                        <Button x:Name="SaveDeletedButton" Style="{StaticResource IconButton}" Content="Save a copy" Tag="&#xE74E;" Click="SaveExternalDeleted_Click" ToolTip="Save what is in the editor as a new test" AutomationProperties.AutomationId="SaveExternalDeleted"/>
                        <Button x:Name="DiscardDeletedButton" Style="{StaticResource IconButton}" Content="Discard" Tag="&#xE74D;" Click="DiscardExternalDeleted_Click" Margin="8,0,0,0" ToolTip="Close this test without saving it" AutomationProperties.AutomationId="DiscardExternalDeleted"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </UserControl>
                <!-- An app named in a description (or stored on a test) matches more than one app: the candidates are buttons (AppChoice1…5), never a dialog. -->
                <UserControl x:Name="AppChoiceBar" Visibility="Collapsed" Focusable="False" Margin="0,0,0,12" AutomationProperties.Name="Choose the app" AutomationProperties.AutomationId="AppChoiceBar">
                  <Border Style="{StaticResource InfoBar}" Padding="14,8,6,8" MinHeight="44">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Control Style="{StaticResource InfoBarIcon}" Tag="Informational" VerticalAlignment="Top" Margin="0,2,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock x:Name="AppChoiceText" TextWrapping="Wrap" AutomationProperties.AutomationId="AppChoiceText" AutomationProperties.LiveSetting="Polite"/>
                        <WrapPanel x:Name="AppChoiceButtons" Margin="0,8,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource IconOnlyButton}" Content="Cancel the app choice" Tag="&#xE711;" FontSize="12" Click="DismissAppChoice_Click" VerticalAlignment="Top" Margin="8,0,0,0" AutomationProperties.AutomationId="DismissAppChoice"/>
                    </Grid>
                  </Border>
                </UserControl>
              </StackPanel>

              <!-- Row 2: the test name (Steps view: a heading across the editor; Last run: beside the views). -->
              <TextBox x:Name="TestName" Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource InlineEdit}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="-7,0,-7,0" VerticalAlignment="Center"
                       TextChanged="Editor_Changed" ToolTip="Test name" AutomationProperties.Name="Test name" AutomationProperties.AutomationId="TestName"/>
              <!-- Row 3: purpose. Row 4: where it runs and the saved state. -->
              <TextBox x:Name="TestIntent" Grid.Row="3" Grid.ColumnSpan="4" Style="{StaticResource InlineEdit}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="64" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="-7,2,-7,0"
                       TextChanged="Editor_Changed" AutomationProperties.Name="What should happen" AutomationProperties.AutomationId="TestIntent"/>
              <StackPanel x:Name="MetaLine" Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                <Control Style="{StaticResource Icon}" Tag="&#xE7F4;" FontSize="12"/>
                <TextBlock x:Name="RunsInText" Text="Runs in the connected app" Style="{StaticResource Caption}" Margin="6,0,20,0" ToolTip="The app this test acts on" AutomationProperties.AutomationId="RunsIn"/>
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                  <Control Tag="&#xE73E;" FontSize="12" HorizontalAlignment="Center">
                    <Control.Style><Style TargetType="Control" BasedOn="{StaticResource Icon}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SaveState}" Value="Saved"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Control.Style>
                  </Control>
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorCautionBrush}">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SaveState}" Value="Saved"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                </Grid>
                <TextBlock x:Name="SaveState" Text="Saved" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
              </StackPanel>

              <!-- Row 5 (Steps view): Run split button and Stop; Record; Improve, Save, Duplicate and Delete. In Last run the run controls move to row 2. -->
              <StackPanel x:Name="RunControls" Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,0,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="RunButton" Style="{StaticResource AccentSplitMain}" Tag="&#xE768;" Click="RunTest_Click" Padding="12,0,14,0" AutomationProperties.Name="Run test" AutomationProperties.AutomationId="RunTest">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="RunVerbText" Text="Run" FontWeight="SemiBold"/>
                      <TextBlock x:Name="RunModeText" Text="AI-guided" Margin="8,0,0,0"/>
                      <TextBlock Text="F5" FontFamily="{StaticResource SmallFont}" FontSize="12" Opacity="0.75" Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Rectangle Grid.Column="1" Fill="{DynamicResource ControlStrokeColorOnAccentTertiaryBrush}"/>
                  <Button x:Name="RunModeButton" Grid.Column="2" Style="{StaticResource AccentSplitDrop}" Content="Choose how to run" Tag="&#xE70D;" Click="RunMode_Click" AutomationProperties.AutomationId="RunMode">
                    <Button.ContextMenu>
                      <ContextMenu x:Name="RunModeMenu">
                        <MenuItem x:Name="RunModeAiItem" Header="AI-guided" Click="RunModeAi_Click" ToolTip="The AI chooses each action from what is on screen, and every saved step and check must be seen in order." AutomationProperties.AutomationId="RunModeAiGuided"/>
                        <MenuItem x:Name="RunModeReplayItem" Header="Exact replay" Click="RunModeReplay_Click" ToolTip="Replays the saved steps exactly, without AI decisions." AutomationProperties.AutomationId="RunModeReplay"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </Grid>
                <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="Stop" Tag="&#xE71A;" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Stop the current operation safely (Shift+F5)" AutomationProperties.AutomationId="StopRun"/>
              </StackPanel>
              <StackPanel x:Name="CommandMiddle" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,14,0,6">
                <Button Style="{StaticResource RecordButton}" Content="Record" Click="Record_Click" ToolTip="Record clicks and typing in the connected app (Automate, Record)" AutomationProperties.AutomationId="RecordTest"/>
              </StackPanel>
              <StackPanel x:Name="CommandRight" Grid.Row="5" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,14,0,6">
                <Button x:Name="ImproveButton" Style="{StaticResource IconButton}" Content="Improve…" Tag="&#xE70F;" Click="Improve_Click" Margin="0,0,8,0" ToolTip="Ask the assistant to revise this test" AutomationProperties.AutomationId="ImproveTest"/>
                <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Content="Save" Tag="&#xE74E;" Click="SaveTest_Click" ToolTip="Save this test (Ctrl+S)" AutomationProperties.AutomationId="SaveTest"/>
                <Button x:Name="DuplicateButton" Style="{StaticResource IconOnlyButton}" Content="Duplicate" Tag="&#xE8C8;" Click="DuplicateTest_Click" Margin="6,0,0,0" ToolTip="Duplicate this test (Ctrl+D)" AutomationProperties.AutomationId="DuplicateTest"/>
                <Button x:Name="DeleteButton" Style="{StaticResource IconOnlyButton}" Content="Delete" Tag="&#xE74D;" Click="DeleteTest_Click" Margin="2,0,0,0" ToolTip="Delete this test (Delete, in the list)" AutomationProperties.AutomationId="DeleteTest"/>
                <!-- Less frequent commands live under More (⋯). -->
                <Button x:Name="MoreButton" Style="{StaticResource IconOnlyButton}" Content="More actions" Tag="&#xE712;" Click="MoreActions_Click" Margin="2,0,0,0" ToolTip="More actions: import or export a test" AutomationProperties.AutomationId="MoreTestActions">
                  <Button.ContextMenu>
                    <ContextMenu x:Name="MoreActionsMenu">
                      <MenuItem Header="Import test…" Click="ImportTest_Click" ToolTip="Add a test from a Testy test file (.json)" AutomationProperties.AutomationId="ImportTest"/>
                      <MenuItem x:Name="ExportTestItem" Header="Export test…" Click="ExportTest_Click" ToolTip="Save this test to a file you can share or import" AutomationProperties.AutomationId="ExportTest"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>

              <!-- Row 6 (Steps view) or row 2 (Last run): the views. The divider runs under the row that holds them. -->
              <TabControl x:Name="EditorTabs" Grid.Row="6" Grid.ColumnSpan="4" Style="{StaticResource ViewSwitcher}" Margin="-12,4,0,0" SelectionChanged="EditorTabs_SelectionChanged" AutomationProperties.Name="Views" AutomationProperties.AutomationId="EditorViews">
                <TabItem x:Name="StepsTab" Header="Steps" Tag="{Binding Items.Count, ElementName=StepsGrid}" ToolTip="The test's steps and checks" AutomationProperties.AutomationId="ViewSteps"/>
                <TabItem x:Name="LastRunTab" Header="Last run" ToolTip="What happened the last time this test ran" AutomationProperties.AutomationId="ViewLastRun"/>
                <TabItem x:Name="JsonTab" Header="JSON" AutomationProperties.AutomationId="ViewJson" Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
              </TabControl>
              <Rectangle x:Name="ViewsDivider" Grid.Row="6" Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False"/>

              <!-- Row 7 (Last run only): the result InfoBar with Copy summary and Open report. -->
              <Border x:Name="RunResultBar" Grid.Row="7" Grid.ColumnSpan="4" Style="{StaticResource InfoBar}" Padding="14,6,8,6" MinHeight="46" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Control x:Name="RunSummaryIcon" Style="{StaticResource InfoBarIcon}" Tag="Informational" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="RunSummary" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="RunSummary"><Run x:Name="RunSummaryWord" FontWeight="SemiBold" Text="Not run yet"/><Run x:Name="RunSummaryText"/></TextBlock>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="CopySummaryButton" Style="{StaticResource IconButton}" Content="Copy summary" Tag="&#xE8C8;" Click="CopySummary_Click" ToolTip="Copy a plain-text summary of this run" AutomationProperties.AutomationId="CopySummary"/>
                    <Button x:Name="OpenRunReportButton" Style="{StaticResource IconButton}" Content="Open report" Tag="&#xE8A7;" Click="OpenRunReport_Click" Margin="8,0,0,0" ToolTip="Open this run's report, with its screenshots and evidence" AutomationProperties.AutomationId="OpenRunReport"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ── Steps view: the steps as sentences (DataItem rows), Add step / Add check, and the docked editor for the selected step. ── -->
            <Grid x:Name="StepsView" Grid.Row="1" Margin="28,12,28,16">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <DataGrid x:Name="StepsGrid" CellStyle="{StaticResource EditableCell}" RowHeight="NaN" MinRowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Disabled" CellEditEnding="StepsGrid_CellEditEnding" SelectionChanged="StepsGrid_SelectionChanged" AutomationProperties.Name="Steps" AutomationProperties.AutomationId="StepsEditor">
                    <DataGrid.Style>
                      <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Setter Property="HeadersVisibility" Value="None"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}}" Value="True"><Setter Property="HeadersVisibility" Value="Column"/></DataTrigger></Style.Triggers>
                      </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="#" Width="44" IsReadOnly="True" CanUserSort="False" HeaderStyle="{StaticResource HeaderFirst}" CellStyle="{StaticResource SentenceCellFirst}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Do" Width="96" IsReadOnly="True" CanUserSort="False" CellStyle="{StaticResource SentenceCell}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                              <Control Tag="&#xE73E;" FontSize="12" Width="18" HorizontalAlignment="Left">
                                <Control.Style><Style TargetType="Control" BasedOn="{StaticResource Icon}"><Setter Property="Visibility" Value="Hidden"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCheck}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Control.Style>
                              </Control>
                              <TextBlock Text="{Binding Verb}" Style="{StaticResource StepVerb}" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <!-- Long sentences wrap to two lines, then end in "…"; the tooltip has the whole sentence. -->
                      <DataGridTemplateColumn Header="Step" Width="*" MinWidth="160" IsReadOnly="True" CanUserSort="False" CellStyle="{StaticResource SentenceCell}">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate><local:StepSentenceBlock Parts="{Binding Parts}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Plain}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridComboBoxColumn x:Name="ActionColumn" Header="Action" SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Width="136" ElementStyle="{StaticResource VerbChip}" EditingElementStyle="{StaticResource CellCombo}" CanUserSort="False"
                                              Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                      <DataGridTextColumn x:Name="SelectorColumn" Header="Selector" Binding="{Binding Selector, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource CellMono}" EditingElementStyle="{StaticResource CellEditorMono}" CanUserSort="False"
                                          Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                      <DataGridTextColumn x:Name="ValueColumn" Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="0.7*" MinWidth="90" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" CanUserSort="False"
                                          Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=StepsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Control Tag="&#xE9D5;" Style="{StaticResource EmptyIcon}"/>
                    <TextBlock Text="No steps yet" Style="{StaticResource EmptyTitle}"/>
                    <TextBlock Text="Add a step or a check, or describe the test under New test from a description." Style="{StaticResource EmptyLine}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-4,8,0,8">
                <Button Style="{StaticResource SubtleButton}" Content="Add step" Tag="&#xE710;" Click="AddStep_Click" ToolTip="Add an action after the selected step" AutomationProperties.AutomationId="AddStep"/>
                <Button Style="{StaticResource SubtleButton}" Content="Add check" Tag="&#xE710;" Click="AddCheck_Click" Margin="4,0,0,0" ToolTip="Add a check of what the app shows after the selected step" AutomationProperties.AutomationId="AddCheck"/>
              </StackPanel>
              <Border x:Name="StepEditorCard" Grid.Row="2" Style="{StaticResource Card}" Padding="16,8,8,14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Style="{StaticResource IconOnlyButton}" Content="Move step up" Tag="&#xE74A;" Click="MoveStepUp_Click" AutomationProperties.AutomationId="MoveStepUp"/>
                      <Button Style="{StaticResource IconOnlyButton}" Content="Move step down" Tag="&#xE74B;" Click="MoveStepDown_Click" Margin="2,0,0,0" AutomationProperties.AutomationId="MoveStepDown"/>
                      <Button Style="{StaticResource IconOnlyButton}" Content="Remove step" Tag="&#xE74D;" Click="RemoveStep_Click" Margin="2,0,0,0" AutomationProperties.AutomationId="RemoveStep"/>
                      <Rectangle Style="{StaticResource VerticalDivider}" Height="20" Margin="6,0"/>
                      <Button Style="{StaticResource SubtleButton}" Content="More options…" Tag="&#xE712;" Click="StepOptions_Click" ToolTip="Wait time and backup ways to find the control" AutomationProperties.AutomationId="StepOptions"/>
                    </StackPanel>
                    <TextBlock x:Name="StepEditorTitle" Text="Step" Style="{StaticResource PaneTitle}"/>
                  </DockPanel>
                  <Grid x:Name="StepEditorFields" Grid.Row="1" Margin="0,4,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="StepEditorHint" Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource HelpText}" Margin="0,6,0,0" Visibility="Collapsed"
                               Text="Connect your app (Change app, or Sample app) to choose from its controls."/>
                    <TextBlock Text="Action" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StepControlLabel" Grid.Column="2" Text="Control" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StepValueLabel" Grid.Column="4" Text="Value" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="StepActionPicker" Grid.Row="1" SelectionChanged="StepActionPicker_Changed" AutomationProperties.Name="Action" AutomationProperties.AutomationId="StepAction"/>
                    <ComboBox x:Name="StepControlPicker" Grid.Row="1" Grid.Column="2" SelectionChanged="StepControlPicker_Changed" AutomationProperties.Name="Control" AutomationProperties.AutomationId="StepControl"
                              ToolTip="The control this step acts on. The list shows the controls found in the connected app."/>
                    <TextBox x:Name="StepValueBox" Grid.Row="1" Grid.Column="4" TextChanged="StepValueBox_Changed" AutomationProperties.Name="Value" AutomationProperties.AutomationId="StepValue"/>
                  </Grid>
                  <Grid x:Name="StepEditorTechnical" Grid.Row="2" Margin="0,10,6,0" Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Selector" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="2" Text="Wait up to (ms)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBox x:Name="StepSelectorBox" Grid.Row="1" Style="{StaticResource MonoBox}" TextChanged="StepSelectorBox_Changed" AutomationProperties.Name="Selector" AutomationProperties.AutomationId="StepSelector"/>
                    <TextBox x:Name="StepTimeout" Grid.Row="1" Grid.Column="2" Style="{StaticResource NumberBox}" Width="120" LostFocus="StepTimeout_LostFocus" AutomationProperties.Name="Step timeout in milliseconds" AutomationProperties.AutomationId="StepTimeout"/>
                  </Grid>
                  <TextBlock x:Name="StepEditorEmpty" Grid.Row="1" Text="Select a step to change it, or add one." Style="{StaticResource HelpText}" Margin="0,4,0,4" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ── Last run view: the run trace, the steps with runner messages, the screenshot with the target outlined, AI notes and Activity. ── -->
            <Grid x:Name="LastRunView" Grid.Row="1" Margin="28,12,28,16" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="TraceCard" Style="{StaticResource Card}" Padding="20,16,20,16">
                <local:RunTraceView x:Name="RunTraceView" MonoFontFamily="{StaticResource MonoFont}" StepSelected="RunTrace_StepSelected"/>
              </Border>
              <Grid x:Name="RunColumns" Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Style="{StaticResource Card}">
                    <ListBox x:Name="RunStepList" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource RunStepItem}" SelectionChanged="RunStepList_SelectionChanged" AutomationProperties.Name="Steps in this run" AutomationProperties.AutomationId="LastRunSteps">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto" MinWidth="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <!-- Row 0 is laid out on 20 px lines: a long sentence wraps to two lines, then ends in "…", and the rest stays on its first line. -->
                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusNode}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{StaticResource Caption}" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Verb}" Style="{StaticResource StepVerb}" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <local:StepSentenceBlock Grid.Column="3" Parts="{Binding Parts}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40" VerticalAlignment="Top" ToolTip="{Binding Plain}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding Message}" ToolTip="{Binding Message}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}"><Style.Triggers><DataTrigger Binding="{Binding IsProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding Technical}" ToolTip="{Binding Technical}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                       Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                    <StackPanel>
                      <Expander x:Name="AiNotesExpander" Background="Transparent" BorderThickness="0" AutomationProperties.Name="AI notes" AutomationProperties.AutomationId="AiNotes">
                        <Expander.Header>
                          <StackPanel Orientation="Horizontal">
                            <Control Style="{StaticResource Icon}" Tag="&#xE8BD;" Margin="0,0,12,0"/>
                            <TextBlock Text="AI notes" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AiNotesSummary" Text="No notes yet" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                          </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="AiNotesText" Style="{StaticResource Body}" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,8,0" AutomationProperties.AutomationId="AiNotesText"/>
                          </ScrollViewer>
                          <Button x:Name="AnalyzeButton" Style="{StaticResource IconButton}" Content="Explain this run" Tag="&#xE82F;" Click="Analyze_Click" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Ask the AI to explain what happened; the explanation is added to these notes" AutomationProperties.AutomationId="ExplainRun"/>
                        </StackPanel>
                      </Expander>
                      <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                      <Button Style="{StaticResource ListRowButton}" Click="RunActivity_Click" ToolTip="Open the activity log filtered to this run" AutomationProperties.Name="Activity" AutomationProperties.AutomationId="RunActivity">
                        <DockPanel>
                          <Control DockPanel.Dock="Right" Style="{StaticResource Icon}" Tag="&#xE8A7;" FontSize="14"/>
                          <Control Style="{StaticResource Icon}" Tag="&#xE81C;" Margin="0,0,12,0"/>
                          <TextBlock Text="Activity" VerticalAlignment="Center"/>
                          <TextBlock Text="Full run log with timings" Style="{StaticResource Caption}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <DockPanel MinHeight="32">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="PreviousStepButton" Style="{StaticResource IconOnlyButton}" Content="Previous step" Tag="&#xE76B;" Click="PreviousStep_Click" AutomationProperties.AutomationId="PreviousStep"/>
                      <TextBlock x:Name="ScreenshotPosition" Style="{StaticResource Caption}" MinWidth="48" TextAlignment="Center" Margin="4,0" AutomationProperties.AutomationId="ScreenshotPosition"/>
                      <Button x:Name="NextStepButton" Style="{StaticResource IconOnlyButton}" Content="Next step" Tag="&#xE76C;" Click="NextStep_Click" AutomationProperties.AutomationId="NextStep"/>
                    </StackPanel>
                    <TextBlock x:Name="ScreenshotCaption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ScreenshotCaption"><Run x:Name="CaptionStep" FontWeight="SemiBold"/><Run x:Name="CaptionPhrase" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                  </DockPanel>
                  <Border x:Name="ShotFrame" Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,6,0,0" ClipToBounds="True">
                    <Grid>
                      <Grid x:Name="ShotStage" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="ShotImage" Stretch="Uniform" StretchDirection="DownOnly" SizeChanged="ShotImage_SizeChanged" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Screenshot of the step" AutomationProperties.AutomationId="ScreenshotImage"/>
                        <Canvas x:Name="ShotOverlay" IsHitTestVisible="False">
                          <Border x:Name="ShotOutline" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="3" Visibility="Collapsed"/>
                          <Border x:Name="ShotTag" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="3" Padding="6,1,6,2" Visibility="Collapsed">
                            <TextBlock x:Name="ShotTagText" FontFamily="{StaticResource SmallFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                          </Border>
                        </Canvas>
                      </Grid>
                      <StackPanel x:Name="ShotEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                        <Control Tag="&#xEB9F;" Style="{StaticResource EmptyIcon}"/>
                        <TextBlock x:Name="ShotEmptyText" Text="No screenshot for this step." Style="{StaticResource EmptyLine}" Margin="0,12,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DockPanel Grid.Row="2" Margin="2,4,0,0" MinHeight="28">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Open run folder" Tag="&#xE838;" Height="28" Margin="8,0,-6,0" Click="OpenRunFolder_Click"
                            ToolTip="The run's screenshots, control snapshots and reports" AutomationProperties.AutomationId="OpenRunFolder"/>
                    <StackPanel x:Name="ShotNoteRow" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border x:Name="ShotSwatch" Width="14" Height="10" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="2" Margin="0,1,8,0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="ScreenshotNote" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ScreenshotNote"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBox x:Name="RunStepDetails" Grid.Row="3" Style="{StaticResource CodeEditor}" IsReadOnly="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" MaxHeight="116" FontSize="12" Padding="10,6" Margin="0,8,0,0"
                           AutomationProperties.Name="Technical details of the step" AutomationProperties.AutomationId="RunStepDetails"
                           Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
              </Grid>
              <StackPanel x:Name="LastRunEmpty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Control Tag="&#xE768;" Style="{StaticResource EmptyIcon}"/>
                <TextBlock Text="No run yet" Style="{StaticResource EmptyTitle}"/>
                <TextBlock Text="Run this test (F5) to see each step, how long it took and a screenshot after it." Style="{StaticResource EmptyLine}"/>
              </StackPanel>
            </Grid>

            <!-- ── JSON view (only with technical details on). ── -->
            <Grid x:Name="JsonView" Grid.Row="1" Margin="28,12,28,16" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="JsonEditor" Style="{StaticResource CodeEditor}" TextChanged="Editor_Changed" AutomationProperties.Name="Test as JSON" AutomationProperties.AutomationId="TestJson"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-4,8,0,0">
                <Button Style="{StaticResource SubtleButton}" Content="Apply JSON" Tag="&#xE73E;" Click="ApplyJson_Click"/>
                <Button Style="{StaticResource SubtleButton}" Content="Reload JSON" Tag="&#xE72C;" Click="RefreshJson_Click" Margin="2,0,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <!-- ═══════════════ Results page ═══════════════ -->
        <Grid Grid.Row="1" x:Name="RunsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="32,24,32,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Results" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Every run keeps its screenshots, the controls Testy saw and a report you can share." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Style="{StaticResource SubtleButton}" Content="Refresh" Tag="&#xE72C;" Click="RefreshRuns_Click"/>
              <Button Style="{StaticResource IconButton}" Content="Open report" Tag="&#xE8A5;" Click="OpenReport_Click" Margin="8,0,0,0"/>
              <Button Style="{StaticResource AccentIconButton}" Content="View run" Tag="&#xE890;" Click="ViewRun_Click" Margin="8,0,0,0" ToolTip="Open the selected run in Tests, on Last run" AutomationProperties.AutomationId="ViewRun"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,24">
            <Grid>
              <DataGrid x:Name="RunsGrid" IsReadOnly="True" MouseDoubleClick="RunsGrid_DoubleClick" AutomationProperties.AutomationId="RunsGrid">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Result" Width="130" SortMemberPath="Status" ClipboardContentBinding="{Binding Status}" HeaderStyle="{StaticResource HeaderFirst}">
                    <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource CellFirst}"><Setter Property="AutomationProperties.Name" Value="{Binding Status}"/></Style></DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, Converter={StaticResource FriendlyTime}}" SortMemberPath="StartedAt" Width="170" ElementStyle="{StaticResource CellTime}"/>
                  <!-- A sentence composed from the run ("5 of 5 steps passed in 1.3 s", "Failed at step 3 of 5"); the runner's own summary is a technical column. -->
                  <DataGridTextColumn Header="Summary" Binding="{Binding Converter={StaticResource RunOutcome}}" Width="2*" CanUserSort="False" ElementStyle="{StaticResource CellSecondary}"/>
                  <DataGridTextColumn Header="Runner summary" Binding="{Binding Summary}" Width="2*" ElementStyle="{StaticResource CellMonoSmall}"
                                      Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                  <DataGridTextColumn Header="Run ID" Binding="{Binding Id}" Width="150" ElementStyle="{StaticResource CellMonoSmall}"
                                      Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                  <DataGridTextColumn Header="Run folder" Binding="{Binding ArtifactDirectory}" Width="*" ElementStyle="{StaticResource CellMonoSmall}"
                                      Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RunsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Control Tag="&#xE9D2;" Style="{StaticResource EmptyIcon}"/>
                <TextBlock Text="No results yet" Style="{StaticResource EmptyTitle}"/>
                <TextBlock Text="Run a test from Tests. Each run keeps its screenshots, the controls Testy saw and a report." Style="{StaticResource EmptyLine}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- ═══════════════ Inspect controls page ═══════════════ -->
        <Grid Grid.Row="1" x:Name="InspectorPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="32,24,32,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Inspect controls" Style="{StaticResource PageTitle}"/>
              <TextBlock x:Name="InspectorSummary" Text="Connect an app to see the controls Testy can find in it." Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Scan again" Tag="&#xE72C;" Click="Inspect_Click" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RefreshInspector"/>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,0">
            <Grid>
              <DataGrid x:Name="ElementsGrid" IsReadOnly="True" RowHeight="34" AutomationProperties.AutomationId="ElementsGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kind" Binding="{Binding ControlType}" Width="120" HeaderStyle="{StaticResource HeaderFirst}" CellStyle="{StaticResource CellFirst}" ElementStyle="{StaticResource CellSecondary}"/>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="Control ID" Binding="{Binding Selector}" Width="1.3*" ElementStyle="{StaticResource CellMono}"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource CellSecondary}"/>
                  <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" HeaderStyle="{StaticResource HeaderCenter}" ElementStyle="{StaticResource GridBool}"/>
                  <DataGridCheckBoxColumn Header="Off screen" Binding="{Binding IsOffscreen}" Width="90" HeaderStyle="{StaticResource HeaderCenter}" ElementStyle="{StaticResource GridBoolWarn}"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ElementsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Control Tag="&#xE8E6;" Style="{StaticResource EmptyIcon}"/>
                <TextBlock Text="No controls yet" Style="{StaticResource EmptyTitle}"/>
                <TextBlock Text="Connect an app, then scan it to list its buttons, fields and other controls." Style="{StaticResource EmptyLine}"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,10,32,20">
            <TextBlock Text="With the selected control:" Style="{StaticResource Caption}" Margin="4,0,8,0"/>
            <Button Style="{StaticResource SubtleButton}" Content="Add click step" Tag="&#xE8B0;" Click="InspectorClickStep_Click"/>
            <Button Style="{StaticResource SubtleButton}" Content="Add text check" Tag="&#xE73A;" Click="InspectorAssertStep_Click" Margin="2,0,0,0"/>
            <Button Style="{StaticResource SubtleButton}" Content="Copy control ID" Tag="&#xE8C8;" Click="CopySelector_Click" Margin="2,0,0,0"/>
            <Button Style="{StaticResource SubtleButton}" Content="View screenshot" Tag="&#xEB9F;" Click="InspectorEvidence_Click" Margin="2,0,0,0"/>
          </StackPanel>
        </Grid>

        <!-- ═══════════════ Settings page (Windows Settings style: one setting per card) ═══════════════ -->
        <!-- Every field stays visible for every service: nothing is hidden per provider. -->
        <Grid Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="32,24,32,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Choose the AI service Testy uses and how tests run. Tests and actions always run on this PC." Style="{StaticResource PageSubtitle}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource AccentIconButton}" Content="Save" Tag="&#xE74E;" Click="SaveSettings_Click" VerticalAlignment="Bottom" Margin="16,0,0,0" ToolTip="Save these settings" AutomationProperties.AutomationId="SaveConnection"/>
            </Grid>
          </Grid>
          <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,0,32,32">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="AI service" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE99A;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Service" Style="{StaticResource SettingTitle}"/><TextBlock Text="Which AI creates tests and guides runs. Offline turns simple commands into steps without AI." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <ComboBox x:Name="ProviderCombo" Grid.Column="2" Width="240" VerticalAlignment="Center" AutomationProperties.Name="AI service" AutomationProperties.AutomationId="ProviderPicker" SelectionChanged="ProviderCombo_SelectionChanged"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}" MinHeight="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource InfoBarIcon}" Margin="6,1,22,0"/>
                    <TextBlock x:Name="ProviderHelp" Grid.Column="1" Style="{StaticResource Body}" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE950;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Model" Style="{StaticResource SettingTitle}"/><TextBlock Text="Leave blank to use Codex's default model." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <TextBox x:Name="ModelBox" Grid.Column="2" Style="{StaticResource MonoBox}" Width="340" VerticalAlignment="Center" AutomationProperties.Name="Model" AutomationProperties.AutomationId="ModelName"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE774;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Server URL" Style="{StaticResource SettingTitle}"/><TextBlock Text="An OpenAI Responses URL, or a compatible Chat Completions URL." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <TextBox x:Name="EndpointBox" Grid.Column="2" Style="{StaticResource MonoBox}" Width="340" VerticalAlignment="Center" AutomationProperties.Name="Server URL" AutomationProperties.AutomationId="ProviderEndpoint"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE8D7;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Key from an environment variable" Style="{StaticResource SettingTitle}"/><TextBlock Text="The name of the environment variable that holds the API key." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <TextBox x:Name="KeyEnvironmentBox" Grid.Column="2" Style="{StaticResource MonoBox}" Width="340" VerticalAlignment="Center" AutomationProperties.Name="Key environment variable" AutomationProperties.AutomationId="ApiKeyVariable"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE756;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Codex program" Style="{StaticResource SettingTitle}"/><TextBlock Text="Path to codex.exe. Leave blank to use the one on your PATH." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <TextBox x:Name="CodexPathBox" Grid.Column="2" Style="{StaticResource MonoBox}" Width="340" VerticalAlignment="Center" AutomationProperties.Name="Codex program" AutomationProperties.AutomationId="CodexExecutable"/>
                  </Grid>
                </Border>

                <TextBlock Text="How tests run" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xF4A5;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Let the AI guide each run" Style="{StaticResource SettingTitle}"/><TextBlock Text="The AI chooses every action from what is on screen. Turn off for an exact replay of the saved steps." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <CheckBox x:Name="AiDirectedCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Let the AI guide each run" AutomationProperties.AutomationId="AiDirectedExecution"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE7F8;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="OpenAI computer-use mode" Style="{StaticResource SettingTitle}"/><TextBlock Text="For supported OpenAI models. When off, the AI uses Testy's control tools. Other services always use them." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <CheckBox x:Name="NativeUseCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="OpenAI computer-use mode" AutomationProperties.AutomationId="NativeComputerUse"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xEB9F;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Send screenshots to the AI" Style="{StaticResource SettingTitle}"/><TextBlock Text="Turn off for text-only models. OpenAI computer-use mode needs screenshots." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <CheckBox x:Name="ImagesCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Send screenshots to the AI" AutomationProperties.AutomationId="SupportsImages"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE9E9;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Most AI actions per run" Style="{StaticResource SettingTitle}"/><TextBlock Text="Up to 240 with Testy's control tools, or 80 in OpenAI computer-use mode." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <TextBox x:Name="MaxTurnsBox" Grid.Column="2" Style="{StaticResource NumberBox}" VerticalAlignment="Center" AutomationProperties.Name="Most AI actions per run" AutomationProperties.AutomationId="MaximumAgentTurns"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE8BD;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="AI comments during exact replay" Style="{StaticResource SettingTitle}"/><TextBlock Text="When the AI doesn't guide the run, it can still comment on each replayed step. It never chooses actions." Style="{StaticResource SettingDescription}"/></StackPanel>
                    <CheckBox x:Name="LiveReviewCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="AI comments during exact replay" AutomationProperties.AutomationId="LiveReview"/>
                  </Grid>
                </Border>

                <TextBlock Text="API key" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}" Padding="16,14,16,16">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE72E;" VerticalAlignment="Top" Margin="4,2,20,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Save an API key in Windows" Style="{StaticResource SettingTitle}"/>
                      <TextBlock Text="Stored in Windows Credential Manager for this server URL. The environment variable stays as a fallback. Checking the connection doesn't click anything in your apps." Style="{StaticResource SettingDescription}"/>
                      <PasswordBox x:Name="CredentialBox" Width="420" HorizontalAlignment="Left" Margin="0,12,0,10" MaxLength="1280" AutomationProperties.Name="API key" AutomationProperties.AutomationId="ProviderCredential"/>
                      <WrapPanel>
                        <Button Style="{StaticResource IconButton}" Content="Save key" Tag="&#xE74E;" Click="StoreCredential_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="StoreCredential"/>
                        <Button Style="{StaticResource IconButton}" Content="Forget key" Tag="&#xE74D;" Click="RemoveCredential_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="RemoveCredential"/>
                        <Button Style="{StaticResource IconButton}" Content="Check connection" Tag="&#xE703;" Click="TestConnection_Click" AutomationProperties.AutomationId="TestConnection"/>
                      </WrapPanel>
                      <TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="ConnectionStatus"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Text="Connecting apps" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xEC7A;" VerticalAlignment="Top" Margin="4,2,20,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="WPF helper" Style="{StaticResource SettingTitle}"/>
                      <TextBlock Style="{StaticResource SettingDescription}">Testy works with any app through Windows UI Automation, with no changes to the app. For WPF apps you own, the optional helper shows Testy more of the app over a private local connection. Call <Run Text="Testy.WpfProbe.ProbeServer.Start()" FontFamily="{StaticResource MonoFont}"/> when your app starts, then turn on "Use the WPF helper" under Change app before you connect.</TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE83D;" VerticalAlignment="Top" Margin="4,2,20,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="What Testy can reach" Style="{StaticResource SettingTitle}"/>
                      <TextBlock Text="Only the connected app receives test actions. Screenshots and test data are saved in your data folder. Use a test account when the app contains private data. API keys stay in Windows Credential Manager or an environment variable and are never saved in test files." Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Agent access: Testy's MCP server for any MCP-capable agent on this PC. Generic on purpose: no agent product is named. -->
                <TextBlock Text="Agent access (MCP)" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}" Padding="16,14,16,16">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Control Style="{StaticResource SettingIcon}" Tag="&#xE968;" VerticalAlignment="Top" Margin="4,2,20,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Let AI agents on this PC create and run tests in Testy through the Model Context Protocol (MCP)." Style="{StaticResource SettingTitle}"/>
                      <TextBlock Text="Any MCP-capable agent can connect; nothing is tied to a particular tool. Tests and runs an agent creates appear here as soon as they are saved." Style="{StaticResource SettingDescription}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Control x:Name="McpStatusIcon" Style="{StaticResource InfoBarIcon}" Tag="Informational" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="McpStatusText" Text="Looking for the server…" TextWrapping="Wrap" MaxWidth="820" VerticalAlignment="Center" AutomationProperties.AutomationId="McpStatus" AutomationProperties.LiveSetting="Polite"/>
                      </StackPanel>
                      <TextBlock Text="Command an agent runs to start the server (stdio)" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="McpCommandBox" Style="{StaticResource MonoBox}" IsReadOnly="True" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Agent command" AutomationProperties.AutomationId="McpCommand"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Copy command" Tag="&#xE8C8;" Click="CopyMcpCommand_Click" Margin="8,0,0,0" ToolTip="Copy this command line" AutomationProperties.AutomationId="CopyMcpCommand"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="Copy JSON" Tag="&#xE943;" Click="CopyMcpJson_Click" Margin="8,0,0,0" ToolTip="Copy the common MCP client configuration: an mcpServers entry named testy with this command and its arguments" AutomationProperties.AutomationId="CopyMcpJson"/>
                      </Grid>
                      <TextBlock x:Name="McpCommandHelp" Text="Copy JSON gives a common MCP client configuration (an mcpServers entry named testy) for agents that read one. The server can start desktop programs and send keyboard and mouse input to the app an agent names, with your rights." Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
                      <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Listen for agents (HTTP)" Style="{StaticResource SettingTitle}"/>
                          <TextBlock Text="Studio keeps the server running on this PC and shows its address for agents that connect over HTTP. Loopback only, and only with the token below; it stops when Studio closes and starts again with it. The switch, the port and the token are remembered for you." Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="McpListenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0" Checked="McpListen_Changed" Unchecked="McpListen_Changed" AutomationProperties.Name="Listen for agents (HTTP)" AutomationProperties.AutomationId="McpListen"/>
                      </Grid>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="McpUrlBox" Style="{StaticResource MonoBox}" IsReadOnly="True" VerticalAlignment="Center" ToolTip="The address agents connect to while Studio listens; empty when it doesn't" AutomationProperties.Name="Agent address" AutomationProperties.AutomationId="McpUrl"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Copy URL" Tag="&#xE8C8;" Click="CopyMcpUrl_Click" Margin="8,0,0,0" ToolTip="Copy the address" AutomationProperties.AutomationId="CopyMcpUrl"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="Copy HTTP JSON" Tag="&#xE943;" Click="CopyMcpHttpJson_Click" Margin="8,0,0,0" ToolTip="Copy an mcpServers entry with this address and the token as its Authorization header" AutomationProperties.AutomationId="CopyMcpHttpJson"/>
                      </Grid>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="McpPortBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="96" VerticalAlignment="Center" LostFocus="McpPort_LostFocus" ToolTip="The loopback port the listener uses next time it starts; 0 lets Windows pick a free one, which is then kept" AutomationProperties.Name="Listener port" AutomationProperties.AutomationId="McpPort"/>
                        <TextBox x:Name="McpTokenBox" Grid.Column="3" Style="{StaticResource MonoBox}" IsReadOnly="True" VerticalAlignment="Center" ToolTip="Every HTTP request must carry this token as Authorization: Bearer …; it is shown only in part" AutomationProperties.Name="Agent token" AutomationProperties.AutomationId="McpToken"/>
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="Copy token" Tag="&#xE8C8;" Click="CopyMcpToken_Click" Margin="8,0,0,0" ToolTip="Copy the bearer token agents send over HTTP" AutomationProperties.AutomationId="CopyMcpToken"/>
                      </Grid>
                      <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource IconButton}" Content="Test the connection" Tag="&#xE703;" Click="TestMcpConnection_Click" Margin="0,0,8,0" ToolTip="Start the server the way an agent does, ask it for its tools, then close it" AutomationProperties.AutomationId="TestMcpConnection"/>
                        <Button Style="{StaticResource IconButton}" Content="Open guide" Tag="&#xE8A5;" Click="OpenMcpGuide_Click" ToolTip="How agents connect to Testy and what they can do" AutomationProperties.AutomationId="OpenMcpGuide"/>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ═══════════════ Automate page host (AutomatePage is created on entry and removed on exit) ═══════════════ -->
        <Border Grid.Row="1" x:Name="AutomateHost" Visibility="Collapsed"/>

        <!-- ═══════════════ Status line ═══════════════ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,0" MinHeight="32">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Control x:Name="StatusIcon" FontSize="12" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
              <Control.RenderTransform><RotateTransform/></Control.RenderTransform>
              <Control.Style>
                <Style TargetType="Control" BasedOn="{StaticResource Icon}">
                  <Setter Property="Tag" Value="&#xE946;"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, ElementName=StatusText}" Value="Error"><Setter Property="Tag" Value="&#xE783;"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                      <Setter Property="Tag" Value="&#xF16A;"/><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                      <DataTrigger.EnterActions><BeginStoryboard x:Name="SpinSb"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SpinSb"/></DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Control.Style>
            </Control>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="ContextStatus" Grid.Column="2" Text="No app connected" Style="{StaticResource Caption}" Margin="16,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                       Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
          </Grid>
        </Border>

        <!-- ═══════════════ Activity pane (in-window, over the right edge of the pages; its list is emptied when it closes) ═══════════════ -->
        <UserControl x:Name="ActivityPanel" Grid.Row="1" Width="420" HorizontalAlignment="Right" Visibility="Collapsed" KeyDown="ActivityPanel_KeyDown" Focusable="False"
                     AutomationProperties.Name="Activity" AutomationProperties.AutomationId="ActivityPanel">
          <Border Style="{StaticResource PaneSurface}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="20,14,10,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource IconOnlyButton}" Content="Close activity" Tag="&#xE711;" FontSize="12" Click="CloseActivity_Click" AutomationProperties.AutomationId="ActivityClose"/>
              <StackPanel>
                <TextBlock Text="Activity" Style="{StaticResource PaneTitle}" FontSize="18"/>
                <TextBlock x:Name="ActivitySubtitle" Text="Messages, saves, runs and errors in this session." Style="{StaticResource HelpText}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="16,6,14,8">
              <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Copy all" Tag="&#xE8C8;" Click="CopyActivity_Click" ToolTip="Copy every entry shown here as text" AutomationProperties.AutomationId="ActivityCopy"/>
              <TabControl x:Name="ActivityFilter" Style="{StaticResource ViewSwitcher}" SelectionChanged="ActivityFilter_SelectionChanged" AutomationProperties.Name="Show" AutomationProperties.AutomationId="ActivityFilter">
                <TabItem Header="All" AutomationProperties.AutomationId="ActivityFilterAll"/>
                <TabItem Header="This run" AutomationProperties.AutomationId="ActivityFilterRun"/>
                <TabItem Header="Errors" AutomationProperties.AutomationId="ActivityFilterErrors"/>
              </TabControl>
            </DockPanel>
            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,0"/>
            <ListBox x:Name="ActivityList" Grid.Row="2" Style="{StaticResource FlatList}" Padding="4,6,4,8" ItemContainerStyle="{StaticResource ActivityItem}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Activity entries" AutomationProperties.AutomationId="ActivityList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding FullTime}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions><Condition Binding="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}}" Value="True"/><Condition Binding="{Binding HasDetail}" Value="True"/></MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Control FontSize="12" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,3,0,0">
                      <Control.Style>
                        <Style TargetType="Control" BasedOn="{StaticResource Icon}">
                          <Setter Property="Tag" Value="&#xE946;"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LevelName}" Value="Error"><Setter Property="Tag" Value="&#xE783;"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding LevelName}" Value="Warning"><Setter Property="Tag" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding LevelName}" Value="Success"><Setter Property="Tag" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Control.Style>
                    </Control>
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}"><Run Text="{Binding TimeText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/><Run Text="   "/><Run Text="{Binding Source, Mode=OneWay}"/></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ActivityList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <Control Tag="&#xE81C;" Style="{StaticResource EmptyIcon}"/>
              <TextBlock x:Name="ActivityEmptyText" Text="Nothing here yet" Style="{StaticResource EmptyTitle}"/>
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6,14,8">
              <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="Open log folder" Tag="&#xE838;" Click="OpenLogFolder_Click" ToolTip="Every entry is also added to a daily log file (studio-YYYYMMDD.log)" AutomationProperties.AutomationId="ActivityLogFolder"/>
                <TextBlock x:Name="ActivityLogPath" Style="{StaticResource HelpText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0,0,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="{Binding ShowTechnicalDetails, Source={x:Static local:StudioPreferences.Current}, Converter={StaticResource BoolToVisibility}}"/>
              </DockPanel>
            </Border>
          </Grid>
        </Border>
        </UserControl>
      </Grid>
    </Border>

    <!-- ═══════════════ Flyouts (light-dismissed from code-behind) ═══════════════ -->
    <Popup x:Name="ChangeAppFlyout" PlacementTarget="{Binding ElementName=ChangeAppButton}" Placement="Bottom" HorizontalOffset="-12" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
      <Border Style="{StaticResource FlyoutSurface}" Width="460" KeyDown="Flyout_KeyDown">
        <StackPanel>
          <TextBlock Text="Connect to an app" Style="{StaticResource PaneTitle}"/>
          <TextBlock Text="Testy sends test actions only to the app you connect." Style="{StaticResource HelpText}" Margin="0,2,0,14"/>
          <TextBlock Text="Open windows" Margin="0,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="TargetCombo" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.Name="Open windows" ToolTip="Only this app receives test actions." AutomationProperties.AutomationId="TargetPicker">
              <!-- Each item is announced (and found by UI Automation) by its window title, not by the type name of the item behind it. -->
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Grid.Column="1" Style="{StaticResource IconOnlyButton}" Content="Refresh the list of windows" Tag="&#xE72C;" Click="RefreshTargets_Click" Margin="4,0,0,0" AutomationProperties.AutomationId="RefreshTargets"/>
          </Grid>
          <CheckBox x:Name="ProbeCheck" Content="Use the WPF helper (for apps that include Testy.WpfProbe)" Margin="0,12,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="AttachButton" Style="{StaticResource AccentIconButton}" Content="Connect" Tag="&#xE71B;" Click="Attach_Click" AutomationProperties.AutomationId="AttachTarget"/>
            <Button Style="{StaticResource IconButton}" Content="Open an app…" Tag="&#xE8E5;" Click="OpenExe_Click" Margin="8,0,0,0" ToolTip="Start a program and connect to its window" AutomationProperties.AutomationId="OpenExe"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="HelpFlyout" PlacementTarget="{Binding ElementName=HelpNav}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
      <Border Style="{StaticResource FlyoutSurface}" Width="440" KeyDown="Flyout_KeyDown">
        <StackPanel>
          <TextBlock Text="Help" Style="{StaticResource PaneTitle}"/>
          <Button Style="{StaticResource SubtleButton}" Content="Documentation" Tag="&#xE8A5;" Click="Documentation_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="-11,8,-11,0" ToolTip="Open the Testy guides (docs folder or README)" AutomationProperties.AutomationId="HelpDocumentation"/>
          <Rectangle Style="{StaticResource HorizontalDivider}"/>
          <TextBlock Text="Keyboard shortcuts" Style="{StaticResource PaneTitle}" Margin="0,4,0,8"/>
          <Grid x:Name="ShortcutsGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          </Grid>
          <Rectangle Style="{StaticResource HorizontalDivider}" Margin="0,12,0,8"/>
          <TextBlock Text="About" Style="{StaticResource PaneTitle}"/>
          <TextBlock x:Name="VersionLabel" Text="Testy" Margin="0,4,0,0"/>
          <TextBlock Text="Windows test studio. Tests run on this PC; the AI service you choose only sees what a test shares with it." Style="{StaticResource HelpText}" Margin="0,2,0,0"/>
          <TextBlock Text="Data folder" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
          <TextBlock x:Name="WorkspacePathText" Style="{StaticResource MonoText}" FontSize="12" TextWrapping="Wrap"/>
          <Button Style="{StaticResource SubtleButton}" Content="Open data folder" Tag="&#xE838;" Click="OpenWorkspace_Click" HorizontalAlignment="Left" Margin="-11,6,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
    <!-- Global search results (Ctrl+K). Exists only while open; the search box keeps the focus. -->
    <Popup x:Name="SearchFlyout" PlacementTarget="{Binding ElementName=GlobalSearch}" Placement="Bottom" HorizontalOffset="-12" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
      <Border Style="{StaticResource FlyoutSurface}" Width="460" Padding="6,8" KeyDown="Flyout_KeyDown">
        <Grid>
          <ListBox x:Name="SearchResults" Style="{StaticResource FlatList}" MaxHeight="380" ItemContainerStyle="{StaticResource SearchResultItem}" SelectionChanged="SearchResults_SelectionChanged"
                   AutomationProperties.Name="Search results" AutomationProperties.AutomationId="GlobalSearchResults">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Control Style="{StaticResource Icon}" Tag="{Binding Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HelpText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SearchEmpty" Text="No tests, purposes or steps match." Style="{StaticResource HelpText}" Margin="10,6" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Popup>
    <!-- Improve this test: describe what should change; the assistant revises the steps. -->
    <Popup x:Name="ImproveFlyout" PlacementTarget="{Binding ElementName=ImproveButton}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
      <Border Style="{StaticResource FlyoutSurface}" Width="440" KeyDown="Flyout_KeyDown">
        <StackPanel>
          <TextBlock Text="Improve this test" Style="{StaticResource PaneTitle}"/>
          <TextBlock Text="Say what should change. The assistant revises the steps from the connected app's controls and this test's last run. You review them before running." Style="{StaticResource HelpText}" Margin="0,2,0,10"/>
          <TextBox x:Name="ImprovePrompt" Style="{StaticResource PromptBoxStyle}" Height="96" Tag="For example: also check that the new customer appears in the list" AutomationProperties.Name="What should change" AutomationProperties.AutomationId="ImprovePrompt"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefineButton" Style="{StaticResource AccentIconButton}" Content="Improve" Tag="&#xE70F;" Click="Refine_Click" MinWidth="110" AutomationProperties.AutomationId="ApplyImprovement"/>
            <Button Style="{StaticResource IconButton}" Content="Cancel" Click="CloseFlyouts_Click" MinWidth="96" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>