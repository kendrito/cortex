<Window x:Class="Testy.TestLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Testy TestLab — Customer Desk" Width="1000" Height="730" MinWidth="850" MinHeight="670" WindowStartupLocation="CenterScreen" Background="#F3F6F5" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" AutomationProperties.AutomationId="CustomerDeskWindow">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="TESTY / TEST LAB" FontSize="12" FontWeight="Bold" Foreground="#547A76"/><TextBlock Text="Customer desk" FontSize="32" FontWeight="SemiBold" Margin="0,7,0,4"/><TextBlock Text="A real WPF application. A controlled place to prove your tests." FontSize="14" Foreground="#65787E"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Background="#DDEDE4" Padding="12,6"><TextBlock Text="●  WPF probe online" FontSize="12" Foreground="#246A45"/></Border>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#DFE6E4" BorderThickness="1" CornerRadius="14" Padding="24">
        <StackPanel>
          <TextBlock Text="New customer" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Create a record with a name and a valid email." Margin="0,6,0,24" FontSize="13" Foreground="#728087"/>
          <TextBlock Text="Full name" Margin="0,0,0,7" FontWeight="SemiBold"/>
          <TextBox x:Name="CustomerName" AutomationProperties.AutomationId="CustomerName" AutomationProperties.Name="Customer name"/>
          <TextBlock Text="Email address" Margin="0,18,0,7" FontWeight="SemiBold"/>
          <TextBox x:Name="CustomerEmail" AutomationProperties.AutomationId="CustomerEmail" AutomationProperties.Name="Customer email"/>
          <Button x:Name="AddCustomer" Content="Add customer" AutomationProperties.AutomationId="AddCustomer" Click="AddCustomer_Click" Margin="0,24,0,16" HorizontalAlignment="Stretch"/>
          <Border Background="#EDF4F1" CornerRadius="7" Padding="12"><TextBlock x:Name="StatusMessage" Text="Ready for a new customer." AutomationProperties.AutomationId="StatusMessage" TextWrapping="Wrap" FontSize="13" MinHeight="34"/></Border>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#DFE6E4" BorderThickness="1" CornerRadius="14" Padding="24">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="Customer directory" FontSize="20" FontWeight="SemiBold"/><Button Content="Review" HorizontalAlignment="Right" Padding="10,5" FontSize="12" Background="#E1EBE8" Foreground="#214C48" AutomationProperties.AutomationId="OpenReview" Click="OpenReview_Click"/></Grid>
          <StackPanel Grid.Row="1" Margin="0,18,0,12"><TextBlock Text="Search by name or email" FontSize="12" Foreground="#64777C" Margin="0,0,0,7"/><TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search customers" TextChanged="SearchBox_TextChanged" ToolTip="Filter by name or email"/></StackPanel>
          <TextBlock x:Name="ResultCount" Grid.Row="2" Text="0 customers" AutomationProperties.AutomationId="ResultCount" FontSize="12" Foreground="#64777C" Margin="0,0,0,10"/>
          <ListBox x:Name="CustomerList" Grid.Row="3" AutomationProperties.AutomationId="CustomerList" AutomationProperties.Name="Customers" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><Border Padding="8,12" BorderBrush="#EDF1EF" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Email}" Foreground="#6B8085" Margin="0,4,0,0" FontSize="12"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#D8E2DF" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><CheckBox x:Name="DefectToggle" Content="Simulate a regression" AutomationProperties.AutomationId="DefectToggle" FontSize="13" Foreground="#6A4B30"/><TextBlock Text="Intentionally changes the success message for failure analysis." FontSize="11" Foreground="#7E8B8D" Margin="19,5,0,0"/></StackPanel>
        <Button x:Name="DelayedButton" Grid.Column="1" Content="Run background check" AutomationProperties.AutomationId="DelayedButton" Click="DelayedButton_Click" Background="#E1EBE8" Foreground="#214C48" Margin="8,0"/>
        <Button x:Name="ResetButton" Grid.Column="2" Content="Reset lab" AutomationProperties.AutomationId="ResetButton" Click="ResetButton_Click" Background="#E1EBE8" Foreground="#214C48"/>
      </Grid>
    </Border>
  </Grid>
</Window>
