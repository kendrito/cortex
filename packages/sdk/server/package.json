{
  "name": "@cortex/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Cortex SDK clients",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/subagent": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/llm-pi-ai": "workspace:*"
  }
}
