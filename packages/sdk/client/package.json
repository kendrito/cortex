{
  "name": "@cortex/sdk-client",
  "description": "TypeScript client SDK for driving a Cortex runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/cortex": "workspace:*"
  },
  "peerDependencies": {
    "@cortex/llm": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/llm": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/cordis": "workspace:~"
  }
}
