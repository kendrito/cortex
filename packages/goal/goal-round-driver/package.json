{
  "name": "@cortex/goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/agent": "workspace:^",
    "@cortex/goal": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/session": "workspace:^",
    "@cortex/cordis": "workspace:^"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:^",
    "@cortex/agent-loop": "workspace:^",
    "@cortex/agent-loop-testkit": "workspace:^",
    "@cortex/goal": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/session": "workspace:^",
    "@cortex/system-prompt": "workspace:^",
    "@cortex/tools": "workspace:^",
    "@cortex/cordis": "workspace:^"
  }
}
