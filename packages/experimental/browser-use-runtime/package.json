{
  "name": "@cortex/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/browser-use": "workspace:*",
    "@cortex/mcp-client": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/browser-use": "workspace:*",
    "@cortex/mcp-client": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/mcp-resources": "workspace:*",
    "@cortex/ptc-runtime": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/attachment-local": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*"
  }
}
