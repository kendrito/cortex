{
  "name": "@cortex/experimental-speech-to-text-sensevoice",
  "description": "Local SenseVoice ONNX transcription with a managed sherpa-onnx process",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/speech-to-text-sensevoice"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/schemastery": "workspace:~",
    "@cortex/timeout": "workspace:*",
    "zod": "^4.4.3",
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/experimental-speech-to-text": "workspace:*",
    "@cortex/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/experimental-speech-to-text": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "tsx": "^4.22.4"
  }
}
