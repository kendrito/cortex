{
  "name": "@cortex/experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/tool-worktree"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/tools": "workspace:*",
    "@cortex/experimental-worktree": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/fs-local": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-local": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/working-directory": "workspace:*",
    "@cortex/experimental-worktree": "workspace:*",
    "@cortex/agent-loop": "workspace:*"
  },
  "icon": "./icon.svg",
  "cortex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@cortex/experimental-worktree": "workspace:*"
  }
}
