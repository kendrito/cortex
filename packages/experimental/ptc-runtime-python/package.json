{
  "name": "@cortex/experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Cortex PTC execution seam",
  "version": "0.3.0-beta.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
