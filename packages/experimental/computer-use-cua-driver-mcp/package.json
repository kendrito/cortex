{
  "name": "@cortex/experimental-computer-use-cua-driver-mcp",
  "description": "Experimental computer use through an installed Cua Driver MCP executable",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/computer-use-cua-driver-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/schemastery": "workspace:~",
    "@cortex/mcp-client": "workspace:*"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/computer-use": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/computer-use": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/attachment-local": "workspace:*",
    "@cortex/session-projection": "workspace:*"
  }
}
