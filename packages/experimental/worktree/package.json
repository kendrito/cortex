{
  "name": "@cortex/experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~",
    "@cortex/timeout": "workspace:*"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/fs-local": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-local": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/working-directory": "workspace:*"
  }
}
