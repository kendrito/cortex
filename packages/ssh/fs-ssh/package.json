{
  "name": "@cortex/fs-ssh",
  "description": "Filesystem provider over the shared POSIX SSH helper",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/ssh/fs-ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/ssh": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/ssh": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*"
  }
}
