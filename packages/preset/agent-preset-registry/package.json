{
  "name": "@cortex/agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/settings": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/typert-protocol": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "dependencies": {
    "@cortex/app-boot": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@cortex/cordis-plugin-group": "workspace:~",
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/atomic-write": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/settings": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/typert-protocol": "workspace:*",
    "@cortex/cordis": "workspace:~",
    "@cortex/hmr": "workspace:*",
    "@cortex/sandbox": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*",
    "@cortex/user-approval": "workspace:*",
    "@cortex/agent-preset": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
