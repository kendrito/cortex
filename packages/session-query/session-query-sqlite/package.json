{
  "name": "@cortex/session-query-sqlite",
  "description": "Concrete ctx.sessionQuery backend with SQLite FTS5 search",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/session-query/session-query-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
