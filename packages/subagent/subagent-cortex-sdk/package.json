{
  "name": "@cortex/subagent-cortex-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Cortex runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/subagent/subagent-cortex-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/sdk-client": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/subprocess": "workspace:*"
  },
  "dependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-instructions": "workspace:*",
    "@cortex/app-boot": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/loader-smoke": "workspace:*",
    "@cortex/sdk-client": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-checkpoint-policy": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/skill-filesystem": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tool-subagent": "workspace:*"
  }
}
