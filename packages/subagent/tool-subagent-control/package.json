{
  "name": "@cortex/tool-subagent-control",
  "description": "Globally named send_message, interrupt_agent, and list_agents tools over ctx.subagents continuations",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./list-agents": {
      "types": "./lib/types/list-agents.d.ts",
      "default": "./lib/types/list-agents.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/tools": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-persistence": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/session-query": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/subagent-fork-in-process": "workspace:*",
    "@cortex/subagent-spawn-in-process": "workspace:*",
    "@cortex/tools": "workspace:*"
  },
  "dependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/util-values": "workspace:*"
  }
}
