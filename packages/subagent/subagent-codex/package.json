{
  "name": "@cortex/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "cortex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/timeout": "workspace:*"
  },
  "dependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/sdk-protocol": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/app-boot": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/loader-smoke": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-checkpoint-policy": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "@cortex/timeout": "workspace:*",
    "@cortex/tool-jobs": "workspace:*",
    "@cortex/tool-subagent": "workspace:*",
    "@cortex/tools": "workspace:*"
  }
}
