{
  "name": "@cortex/spill-local",
  "description": "Local-filesystem implementation of the Cortex spill storage seam (private session-scoped files)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/spill": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/brand": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/cordis": "workspace:~"
  }
}
