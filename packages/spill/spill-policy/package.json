{
  "name": "@cortex/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/llm": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/cordis": "workspace:~",
    "@cortex/attachment": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/token-meter": "workspace:*"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@cortex/attachment-local": "workspace:*",
    "@cortex/cordis": "workspace:~",
    "@cortex/fs": "workspace:*",
    "@cortex/fs-local": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/llm-pi-ai": "workspace:*",
    "@cortex/mcp-client": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/ptc-runtime": "workspace:*",
    "@cortex/ptc-runtime-node": "workspace:*",
    "@cortex/sandbox-local": "workspace:*",
    "@cortex/sandbox-policy": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/spill-local": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "@cortex/token-meter": "workspace:*",
    "@cortex/tool-fs": "workspace:*",
    "@cortex/tools": "workspace:*",
    "sharp": "^0.35.3"
  }
