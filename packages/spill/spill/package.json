{
  "name": "@cortex/spill",
  "description": "Abstract spill storage seam (ctx.spillStore) for the Cortex — save oversized tool text and return a retrieval locator",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/spill/spill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/cordis": "workspace:~"
  }
}
