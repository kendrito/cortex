{
  "name": "@cortex/tool-lsp",
  "description": "Model-facing lsp tool over the Cortex LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/lsp": "workspace:^",
    "@cortex/system-prompt": "workspace:^",
    "@cortex/timeout": "workspace:^",
    "@cortex/tools": "workspace:^",
    "@cortex/cordis": "workspace:^"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:^",
    "@cortex/fs-local": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/lsp": "workspace:^",
    "@cortex/lsp-stdio": "workspace:^",
    "@cortex/session": "workspace:^",
    "@cortex/subprocess-local": "workspace:^",
    "@cortex/system-prompt": "workspace:^",
    "@cortex/timeout": "workspace:^",
    "@cortex/tool-call-timeout-policy": "workspace:^",
    "@cortex/tools": "workspace:^",
    "@cortex/cordis": "workspace:^"
  }
}
