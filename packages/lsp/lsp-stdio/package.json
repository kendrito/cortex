{
  "name": "@cortex/lsp-stdio",
  "description": "Generic stdio language-server provider for the Cortex LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/brand": "workspace:^",
    "@cortex/fs": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/lsp": "workspace:^",
    "@cortex/subprocess": "workspace:^",
    "@cortex/timeout": "workspace:^",
    "@cortex/cordis": "workspace:^"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@cortex/brand": "workspace:^",
    "@cortex/fs": "workspace:^",
    "@cortex/fs-local": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/lsp": "workspace:^",
    "@cortex/subprocess": "workspace:^",
    "@cortex/subprocess-local": "workspace:^",
    "@cortex/timeout": "workspace:^",
    "@cortex/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
