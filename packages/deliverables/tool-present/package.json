{
  "name": "@cortex/tool-present",
  "description": "Explicit workspace file delivery declarations for the Cortex",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/tools": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/fs": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/fs-local": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/scope": "workspace:*"
  }
}
