{
  "name": "@cortex/tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/jobs": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/workflow": "workspace:*"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/jobs": "workspace:*",
    "@cortex/jobs-local": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tool-jobs": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/workflow": "workspace:*",
    "@cortex/workflow-ptc": "workspace:*"
  }
}
