{
  "name": "@cortex/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Cortex",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/brand": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/brand": "workspace:*",
    "@cortex/invariants": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "@cortex/cordis-plugin-timer": "workspace:~",
    "@cortex/app-boot": "workspace:*",
    "@cortex/hmr": "workspace:*",
    "@cortex/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@cortex/util-values": "workspace:*",
    "@cortex/config-editor": "workspace:*",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
