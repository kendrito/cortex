{
  "name": "@cortex/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@cortex/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex/llm": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/timeout": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/subprocess": "workspace:*",
    "@cortex/subprocess-local": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/timeout": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/cordis": "workspace:~",
    "@cortex/scope": "workspace:*"
  }
}
