{
  "name": "@cortex/fs-local",
  "description": "Local-filesystem implementation of the Cortex filesystem seam (ctx.fs)",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/fs": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "3.1.1",
    "@cortex/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex/fs": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/cordis": "workspace:~"
  }
}
