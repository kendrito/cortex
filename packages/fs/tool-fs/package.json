{
  "name": "@cortex/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Cortex filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@cortex/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@cortex/attachment": "workspace:^",
    "@cortex/fs": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/sandbox": "workspace:^",
    "@cortex/sandbox-policy": "workspace:^",
    "@cortex/session": "workspace:^",
    "@cortex/system-prompt": "workspace:^",
    "@cortex/tools": "workspace:^",
    "@cortex/user-approval": "workspace:^",
    "@cortex/cordis": "workspace:^"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:^",
    "@cortex/agent-loop": "workspace:^",
    "@cortex/agent-loop-testkit": "workspace:^",
    "@cortex/attachment": "workspace:^",
    "@cortex/fs": "workspace:^",
    "@cortex/fs-local": "workspace:^",
    "@cortex/fs-observation-policy": "workspace:^",
    "@cortex/invariants": "workspace:^",
    "@cortex/llm": "workspace:^",
    "@cortex/sandbox": "workspace:^",
    "@cortex/sandbox-policy": "workspace:^",
    "@cortex/session": "workspace:^",
    "@cortex/system-prompt": "workspace:^",
    "@cortex/tools": "workspace:^",
    "@cortex/user-approval": "workspace:^",
    "@cortex/cordis": "workspace:^"
  }
}
