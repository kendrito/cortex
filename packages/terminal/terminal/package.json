{
  "name": "@cortex/terminal",
  "description": "Persistent PTY session seam for the Cortex — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/brand": "workspace:*",
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/brand": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/cordis": "workspace:~"
  }
}
