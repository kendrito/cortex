{
  "name": "@cortex/client-ui-settings-shell",
  "description": "Settings page of the shell executor on the cortex web client's Plugins page: the command timeout and the per-stream output cap of the shell namespace",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-settings-shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/client-locale",
        "@cortex/client-ui-settings",
        "@cortex/client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/api-remotes": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-store": "workspace:*",
    "@cortex/client-test-runtime": "workspace:*",
    "@cortex/client-ui-plugin-manager": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/client-ui-settings": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
