{
  "name": "@cortex/client-ui-settings-models",
  "description": "Models settings and shared product-onboarding dialogs over existing settings and credential joins",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-settings-models"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/client-ui-settings",
        "@cortex/client-locale",
        "@cortex/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/host-webserver": "workspace:*",
    "@cortex/api-remotes": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-store": "workspace:*",
    "@cortex/client-test-runtime": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-settings": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "@cortex/cordis": "workspace:~",
    "react": "^18.2.0",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/util-values": "workspace:*",
    "@cortex/remote-mock": "workspace:*"
  },
  "dependencies": {
    "@cortex/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
