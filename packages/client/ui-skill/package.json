{
  "name": "@cortex/client-ui-skill",
  "description": "Web skill references and the dedicated skill tool row",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-skill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/api-session-controller",
        "@cortex/client-locale",
        "@cortex/client-ui-renderer",
        "@cortex/client-ui-tool",
        "@cortex/client-ui-input-trigger",
        "@cortex/api-remotes",
        "@cortex/client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/api-remotes": "workspace:*",
    "@cortex/api-session-controller": "workspace:*",
    "@cortex/client-connection": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-test-runtime": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-input-trigger": "workspace:*",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@cortex/client-ui-tool": "workspace:*",
    "@cortex/session": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@cortex/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@cortex/client-ui-sidebar-right": "workspace:*",
    "@cortex/util-workspace-path": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
