{
  "name": "@cortex/client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/api-session-controller",
        "@cortex/client-locale",
        "@cortex/client-ui-conversation",
        "@cortex/client-ui-renderer",
        "@cortex/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-test-runtime": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-conversation": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@cortex/compaction": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@cortex/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@cortex/client-store": "workspace:*",
    "@cortex/client-ui-chat": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/api-session-controller": "workspace:*",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/client-ui-session": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
