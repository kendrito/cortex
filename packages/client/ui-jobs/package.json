{
  "name": "@cortex/client-ui-jobs",
  "description": "Session-header background-job list with on-demand streaming record panels",
  "version": "0.2.0-rc.2.cortex.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/api-job-controller": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-test-runtime": "workspace:*",
    "@cortex/client-ui-conversation": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/client-ui-session": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@cortex/jobs": "workspace:*",
    "@cortex/session": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "cortex": {
    "client": {
      "inject": [
        "@cortex/api-job-controller",
        "@cortex/client-locale",
        "@cortex/client-ui-conversation",
        "@cortex/client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
