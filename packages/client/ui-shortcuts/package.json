{
  "name": "@cortex/client-ui-shortcuts",
  "description": "Keyboard shortcut reference, recording, and local preference editing",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/ui-shortcuts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/client-shortcuts",
        "@cortex/client-locale",
        "@cortex/client-ui-layout",
        "@cortex/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/client-shortcuts": "workspace:*",
    "@cortex/client-locale": "workspace:*",
    "@cortex/client-store": "workspace:*",
    "@cortex/client-ui-slots": "workspace:*",
    "@cortex/client-ui-primitives": "workspace:*",
    "@cortex/client-ui-renderer": "workspace:*",
    "@cortex/client-ui-layout": "workspace:*",
    "@cortex/client-ui-settings": "workspace:*",
    "@cortex/brand": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "@cortex/client-test-runtime": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
