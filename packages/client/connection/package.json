{
  "name": "@cortex/client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@cortex/credentials": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/scope": "workspace:*"
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/attachment": "workspace:*",
    "@cortex/brand": "workspace:*",
    "@cortex/host-webserver": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/typert-protocol": "workspace:*"
  }
}
