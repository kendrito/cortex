{
  "name": "@cortex/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/util-values": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/compaction": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/session-projection-cache": "workspace:*",
    "@cortex/session-query": "workspace:*",
    "@cortex/session-title": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cortex/spill": {
      "optional": true
    },
    "@cortex/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/cordis-plugin-include": "workspace:~",
    "@cortex/cordis-plugin-loader": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/compaction": "workspace:*",
    "@cortex/fs-local": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/output-retention": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/session-projection-cache": "workspace:*",
    "@cortex/session-query": "workspace:*",
    "@cortex/session-query-sqlite": "workspace:*",
    "@cortex/session-title": "workspace:*",
    "@cortex/spill": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/spill-local": "workspace:*",
    "@cortex/system-prompt": "workspace:*",
    "@cortex/tool-fs": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/typert-protocol": "workspace:*"
  }
}
