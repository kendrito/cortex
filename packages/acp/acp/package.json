{
  "name": "@cortex/acp",
  "description": "Automation-only Agent Client Protocol server for driving Cortex agents over JSON-RPC stdio",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@cortex/brand": "workspace:*",
    "@cortex/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/mcp-client": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-persistence": "workspace:*",
    "@cortex/token-meter": "workspace:*",
    "@cortex/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cortex/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/agent": "workspace:*",
    "@cortex/agent-loop": "workspace:*",
    "@cortex/agent-loop-testkit": "workspace:*",
    "@cortex/attachment": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/mcp-client": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/session-persistence": "workspace:*",
    "@cortex/session-persistence-jsonl": "workspace:*",
    "@cortex/session-projection": "workspace:*",
    "@cortex/token-meter": "workspace:*",
    "@cortex/tools": "workspace:*",
    "@cortex/user-approval": "workspace:*"
  }
}
