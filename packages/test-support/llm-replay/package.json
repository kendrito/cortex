{
  "name": "@cortex/llm-replay",
  "description": "Replay LLM plugin: short-circuits llm/stream with model chunks reconstructed from a recorded session JSONL (keyless snapshot tests)",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/test-support/llm-replay"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/compaction": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/compaction": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/session": "workspace:*"
  },
  "dependencies": {
    "@cortex/session-format-catalog": "workspace:*",
    "@cortex/util-values": "workspace:*"
  }
}
