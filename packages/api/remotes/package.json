{
  "name": "@cortex/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.0-rc.2.cortex.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@cortex/deque": "workspace:*",
    "@cortex/session": "workspace:*",
    "@cortex/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/scope": "workspace:*"
  },
  "devDependencies": {
    "@cortex/agent": "workspace:*",
    "@cortex/agent-preset-registry": "workspace:*",
    "@cortex/api-gateway": "workspace:*",
    "@cortex/api-job-controller": "workspace:*",
    "@cortex/api-session-controller": "workspace:*",
    "@cortex/api-settings-controller": "workspace:*",
    "@cortex/api-workspace-controller": "workspace:*",
    "@cortex/api-workspace-files": "workspace:*",
    "@cortex/client-connection": "workspace:*",
    "@cortex/client-file-upload": "workspace:*",
    "@cortex/commands": "workspace:*",
    "@cortex/cordis-host-runner": "workspace:*",
    "@cortex/credentials": "workspace:*",
    "@cortex/file-reference": "workspace:*",
    "@cortex/goal": "workspace:*",
    "@cortex/host-plugin-inventory": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/message-feedback": "workspace:*",
    "@cortex/permission-presets": "workspace:*",
    "@cortex/schedule": "workspace:*",
    "@cortex/scope": "workspace:*",
    "@cortex/session-reference": "workspace:*",
    "@cortex/settings": "workspace:*",
    "@cortex/subagent": "workspace:*",
    "@cortex/typert-protocol": "workspace:*",
    "@cortex/user-approval": "workspace:*",
    "@cortex/user-questions": "workspace:*",
    "@cortex/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@cortex/command-feedback": "workspace:*",
    "@cortex/api-terminal-controller": "workspace:*",
    "@cortex/plugin-manager": "workspace:*",
    "@cortex/client-ui-plugin-manager": "workspace:*",
    "@cortex/office-to-pdf": "workspace:*",
    "@cortex/deepseek-account": "workspace:*"
  }
}
