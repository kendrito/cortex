{
  "name": "@cortex/api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.3.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/cortex.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./stream-protocol": {
      "types": "./lib/types/stream-protocol.d.ts",
      "default": "./lib/types/stream-protocol.js"
    }
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex/typert-registry",
        "@cortex/client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex/deque": "workspace:*",
    "@cortex/timeout": "workspace:*",
    "@cortex/schemastery": "workspace:~",
    "ws": "^8.21.0",
    "@cortex/typert-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@cortex/cordis": "workspace:~",
    "@cortex/client-connection": "workspace:*"
  },
  "devDependencies": {
    "@cortex/brand": "workspace:*",
    "@cortex/cmdline": "workspace:*",
    "@cortex/client-connection": "workspace:*",
    "@cortex/host-webserver": "workspace:*",
    "@cortex/remote-mock": "workspace:*",
    "@cortex/typert-registry": "workspace:*",
    "@cortex/util-crypto": "workspace:*",
    "@types/ws": "^8.18.1",
    "@cortex/cordis": "workspace:~",
    "zod": "^4.4.3"
  }
}
