{
  "name": "@cortex/progress-board",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A live progress board above the Cortex composer: an estimated bar, the todo list, and a row per subagent as it works.",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/host.js",
  "exports": { ".": "./lib/host.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@cortex/client-ui-slots": "*",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@cortex/client-ui-slots": { "optional": true }
  },
  "devDependencies": { "esbuild": "0.25.0", "typescript": "5.9.3", "@types/node": "22.20.4", "@types/react": "18.3.31" },
  "cortex": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@cortex/client-ui-slots"]
    }
  }
}
